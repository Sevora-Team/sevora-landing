---
// A static host serves this single 404.html for every locale, so it shows both languages.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from '@/components/ui/Icon.astro';
import { langTags, languages, type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

const [primary, ...others] = Object.keys(languages) as Lang[];
const t = useTranslations(primary);
---

<BaseLayout title={`${t('notFound.title')} · SEVORA`} noindex>
  <main>
    {[primary, ...others].map((lang) => {
      const tl = useTranslations(lang);
      return (
        <section lang={langTags[lang]}>
          {lang === primary ? <h1>{tl('notFound.title')}</h1> : <h2>{tl('notFound.title')}</h2>}
          <p>{tl('notFound.body')}</p>
          <a href={getRelativeLocaleUrl(lang)}>
            <Icon name="arrow-back" />
            {tl('notFound.home')}
          </a>
        </section>
      );
    })}
  </main>
</BaseLayout>
