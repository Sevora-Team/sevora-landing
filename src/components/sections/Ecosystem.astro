---
import { Image } from 'astro:assets';
import affiliatePhoto from '@/assets/photos/home/affiliate.webp';
import shopPhoto from '@/assets/photos/home/shop.webp';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { shop, affiliate } = useTranslations(getLangFromUrl(Astro.url)).ecosystem;
---

<section class="section ecosystem" id="ekosistem">
  <div class="wrap grid">
    <article class="card card-teal reveal-left" data-theme="dark">
      <div class="photo parallax">
        <Image src={shopPhoto} alt="" widths={[600, 900]} sizes="(max-width: 1080px) 100vw, 58vw" />
      </div>
      <div>
        <span class="icon-circle">
          <Icon name="storefront" />
        </span>
        <h3 class="h3">{shop.title}</h3>
        <p class="body-sm">{shop.text}</p>
      </div>
      <ul class="chips">
        {shop.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <div class="btn-row">
        <Button href={links.shop} size="sm" icon="north-east">
          {shop.cta}
        </Button>
      </div>
    </article>

    <article class="card card-grey reveal-right">
      <div class="photo parallax">
        <Image
          src={affiliatePhoto}
          alt=""
          widths={[600, 900]}
          sizes="(max-width: 1080px) 100vw, 58vw"
        />
      </div>
      <div>
        <span class="icon-circle">
          <Icon name="handshake" />
        </span>
        <h3 class="h3">{affiliate.title}</h3>
        <p class="body-sm">{affiliate.text}</p>
      </div>
      <p class="stat">
        <strong>{affiliate.stat}</strong>
        <span>{affiliate.statText}</span>
      </p>
      <ol class="steps">
        {affiliate.steps.map((step, i) => (
          <li>
            <span class="number">{String(i + 1).padStart(2, '0')}</span>
            {step}
          </li>
        ))}
      </ol>
      <div class="btn-row">
        <Button href={links.affiliate} variant="ghost" size="sm" icon="north-east">
          {affiliate.cta}
        </Button>
      </div>
    </article>
  </div>
</section>

<style>
  .ecosystem {
    padding-top: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-height: 440px;
    padding: 40px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--bg);
    transition: border-color 0.25s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card-teal {
    border-color: var(--teal-line);
    background: var(--teal-grad);
  }

  .card-teal:hover {
    border-color: rgb(66 202 215 / 0.5);
  }

  .card-grey {
    border-color: var(--teal-line-soft);
    background: var(--teal-glass-lifted);
  }

  .card > .photo {
    position: relative;
    height: 230px;
    border-radius: var(--radius);
  }

  .photo img {
    transition: transform 1s var(--ease);
  }

  .card:hover .photo img {
    transform: scale(1.045);
  }

  .h3 {
    margin-top: 20px;
  }

  .card .body-sm {
    max-width: 42ch;
    margin-top: 10px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 560px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font: 400 13px/18px var(--font-sans);
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
  }

  .stat strong {
    font: 400 64px/68px var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .stat span {
    max-width: 22ch;
    font-size: 15px;
    line-height: 22px;
  }

  .steps {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .steps li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 15px;
  }

  .number {
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card {
      min-height: 0;
      padding: 24px;
    }

    .card > .photo {
      height: 180px;
    }

    .stat strong {
      font-size: 48px;
      line-height: 52px;
    }
  }
</style>
