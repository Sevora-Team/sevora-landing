---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { curriculum } = useTranslations(lang).academyPage;
const levels = (await getCollection('academy'))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order)
  .map((level) => ({
    ...level,
    id: `nivo-${level.order}`,
    lessonCount: level.modules.reduce((sum, module) => sum + module.lessons.length, 0),
  }));
---

<section class="section curriculum" id="program">
  <div class="wrap">
    <div class="intro">
      <h2 class="h2 reveal">{curriculum.title}</h2>
      <p class="lead reveal">{curriculum.lead}</p>
    </div>

    <nav class="jump reveal" aria-label={curriculum.jump}>
      {levels.map(({ id, label, title }) => (
        <a href={`#${id}`}>
          <span class="mono-label">{label[lang]}</span>
          {title[lang]}
        </a>
      ))}
    </nav>

    {levels.map(({ id, label, title, subtitle, goal, modules, lessonCount }) => (
      <section class="level" id={id} aria-labelledby={`${id}-title`}>
        <header class="head reveal">
          <p class="mono-label level-label">
            {label[lang]} · {subtitle[lang]}
          </p>
          <h3 class="h3" id={`${id}-title`}>
            {title[lang]}
          </h3>
          <p>{goal[lang]}</p>
          <p class="caption">
            {curriculum.modules(modules.length)} · {curriculum.lessons(lessonCount)}
          </p>
        </header>

        <div class="modules">
          {modules.map(({ number, title, lessons, milestone }) => (
            <details class="reveal">
              <summary>
                <span class="mono-label">
                  {curriculum.module} {number}
                </span>
                <span class="module-title">{title[lang]}</span>
                <span class="caption count">{curriculum.lessons(lessons.length)}</span>
                <span class="toggle">
                  <Icon name="expand-more" />
                </span>
              </summary>
              <div class="body">
                <ol class="lessons">
                  {lessons.map(({ number, title }) => (
                    <li>
                      <span class="mono-label">{number}</span>
                      <span>{title[lang]}</span>
                    </li>
                  ))}
                </ol>
                <p class="milestone body-sm">
                  <Icon name="verified-user" size={18} />
                  <span>
                    <strong>{curriculum.milestone}:</strong> {milestone[lang]}
                  </span>
                </p>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>
</section>

<style>
  .curriculum {
    padding-top: 0;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 40px 0 24px;
  }

  .jump a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font: 400 15px/20px var(--font-sans);
    text-decoration: none;
    transition: border-color 0.2s var(--ease);
  }

  .jump a:hover {
    border-color: var(--accent-border);
  }

  .level {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: start;
    gap: 56px;
    padding-top: 56px;
    border-top: 1px solid var(--border);
    margin-top: 56px;
  }

  .head {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    display: grid;
    gap: 12px;
  }

  .level-label {
    color: var(--accent-text);
  }

  .head p {
    margin: 0;
  }

  .modules {
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto 32px;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    color: var(--text);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .module-title {
    font: 400 18px/26px var(--font-sans);
    transition: color 0.2s var(--ease);
  }

  summary:hover .module-title {
    color: var(--accent-text);
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--surface-hover);
    color: var(--text);
    transition: transform 0.3s var(--ease);
  }

  details[open] .toggle {
    transform: rotate(180deg);
  }

  .body {
    padding: 0 0 24px 104px;
    animation: fade 0.35s var(--ease) both;
  }

  .lessons {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lessons li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 12px;
  }

  .lessons .mono-label {
    padding-top: 5px;
  }

  .milestone {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .milestone :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }

  .milestone strong {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 1080px) {
    .level {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .head {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .level {
      margin-top: 40px;
      padding-top: 40px;
    }

    summary {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 4px 12px;
    }

    summary .mono-label,
    .module-title,
    .count {
      grid-column: 1;
    }

    .toggle {
      grid-column: 2;
      grid-row: 1 / span 3;
    }

    .body {
      padding-left: 0;
    }
  }
</style>
