---
// The three plans at monthly prices, with a light running round the featured one.
// The full comparison and yearly billing live on the plans page.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { formatPrice, planPrice, prices } from '@/data/pricing';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { pricing, homePlans: t } = useTranslations(lang);

const plans = [
  { ...pricing.plans.free, price: formatPrice(0, lang), per: pricing.forever, featured: false },
  {
    ...pricing.plans.starter,
    price: planPrice(prices[lang].starter, lang).monthly,
    per: pricing.perMonth,
    featured: false,
  },
  {
    ...pricing.plans.premium,
    price: planPrice(prices[lang].premium, lang).monthly,
    per: pricing.perMonth,
    featured: true,
  },
];
---

<section class="section home-plans" id="paketi">
  <div class="wrap">
    <div class="intro-center">
      <h2 class="h2 reveal-title">{t.title}</h2>
      <p class="lead reveal">{t.lead}</p>
    </div>

    <div class="plans">
      {plans.map(({ name, description, items, cta, price, per, featured }) => (
        <article class:list={['plan', 'reveal', { featured }]}>
          <h3 class="h3">{name}</h3>
          <p class="body-sm">{description}</p>
          <p class="price">
            <strong>{price}</strong>
            <span class="caption">{per}</span>
          </p>
          <ul>
            {items.map((item) => (
              <li>
                <Icon name="check" class="check" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <Button class="cta" href={links.signup} variant={featured ? 'primary' : 'ghost'}>
            {cta}
          </Button>
        </article>
      ))}
    </div>

    <div class="foot">
      <p class="guarantee">
        <Icon name="verified-user" />
        {pricing.guarantee}
      </p>
      <a class="compare" href={getPageUrl(lang, 'plans')}>
        {t.compare}
        <Icon name="north-east" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  @property --angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes run {
    to {
      --angle: 360deg;
    }
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1180px;
    margin-inline: auto;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 34px 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .featured {
    border-color: transparent;
    background: var(--teal-glass-lifted);
  }

  /* A short gold-to-teal light running round the featured plan's border. */
  .featured::before {
    content: '';
    position: absolute;
    inset: -1px;
    padding: 1.5px;
    border-radius: inherit;
    background:
      conic-gradient(
        from var(--angle),
        transparent 0 70%,
        var(--price) 80%,
        var(--accent) 90%,
        transparent 100%
      ),
      linear-gradient(var(--border), var(--border));
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
    animation: run 5s linear infinite;
  }

  .h3 {
    font: 700 26px/32px var(--font-display);
    letter-spacing: -0.02em;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }

  .price strong {
    color: var(--text);
    font: 700 44px/1 var(--font-display);
    letter-spacing: -0.03em;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 24px;
  }

  .check {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }

  .cta {
    justify-content: center;
    margin-top: auto;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 32px;
    margin-top: 32px;
    font-size: 15px;
  }

  .guarantee {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .guarantee svg {
    color: var(--accent-text);
  }

  .compare {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-text);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  @media (max-width: 1080px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
      max-width: 640px;
    }
  }
</style>
