---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { formatPrice, planPrice, prices } from '@/data/pricing';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

// The plan cards on the plans page. They rise into the page hero, which holds the billing toggle.
const lang = getLangFromUrl(Astro.url);
const { pricing } = useTranslations(lang);

const plans = [
  { ...pricing.plans.free, price: undefined, featured: false },
  { ...pricing.plans.starter, price: planPrice(prices[lang].starter, lang), featured: false },
  { ...pricing.plans.premium, price: planPrice(prices[lang].premium, lang), featured: true },
];
---

<section class="pricing" id="paketi">
  <div class="wrap">
    <div class="plans">
      {plans.map(({ name, description, items, cta, price, featured }, i) => (
        <article
          class:list={['plan', 'rise', { featured }]}
          style={`--delay: ${0.6 + i * 0.12}s`}
          data-theme={featured ? 'dark' : undefined}
        >
          <div>
            <h2 class="h3">{name}</h2>
            <p class="body-sm description">{description}</p>
          </div>
          <div>
            {price ? (
              <>
                <p class="price when-monthly">
                  <strong>{price.monthly}</strong>
                  <span class="per">{pricing.perMonth}</span>
                </p>
                <p class="price when-yearly">
                  <strong>{price.yearly}</strong>
                  <s>{price.monthly}</s>
                  <span class="per">{pricing.perMonth}</span>
                </p>
                <p class="caption note when-monthly">{pricing.noteMonthly}</p>
                <p class="caption note when-yearly">{pricing.noteYearly(price.yearlyTotal)}</p>
              </>
            ) : (
              <>
                <p class="price">
                  <strong>{formatPrice(0, lang)}</strong>
                  <span class="per">{pricing.forever}</span>
                </p>
                <p class="caption note">{pricing.noteFree}</p>
              </>
            )}
          </div>
          <div class="features">
            <p class="caption">{pricing.included}</p>
            <ul>
              {items.map((item) => (
                <li>
                  <Icon name="check" class="check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <Button class="cta" href={links.signup} variant={featured ? 'primary' : 'ghost'}>
            {cta}
          </Button>
        </article>
      ))}
    </div>

    <p class="caption guarantee">
      <Icon name="verified-user" size={16} />
      {pricing.guarantee}
    </p>
  </div>
</section>

<style>
  .pricing {
    padding-bottom: 24px;
  }

  /* The cards rise into the page hero above. */
  .plans {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: -180px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 40px;
    border: 1px solid var(--teal-line-soft);
    border-radius: var(--radius-card);
    background: var(--teal-glass);
    transition:
      border-color 0.25s var(--ease),
      transform 0.35s var(--ease);
  }

  .plan:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .featured {
    border-color: var(--teal-line);
    background: var(--teal-grad);
  }

  .featured:hover {
    border-color: rgb(66 202 215 / 0.5);
  }

  .description {
    margin-top: 6px;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
  }

  .price strong {
    font: 400 44px/52px var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .price s {
    font: 400 18px/24px var(--font-sans);
    color: var(--text-muted);
  }

  .per {
    font: 400 14px/16px var(--font-sans);
    color: var(--text-muted);
  }

  .note {
    min-height: 16px;
    margin-top: 4px;
  }

  .features {
    display: grid;
    gap: 14px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--surface-hover);
  }

  .featured .features {
    border: 1px solid var(--teal-line);
    background: rgb(255 255 255 / 0.04);
  }

  .features ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 24px;
  }

  .check {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }

  .cta {
    justify-content: center;
    margin-top: auto;
  }

  .guarantee {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    font-size: 14px;
  }

  .guarantee svg {
    color: var(--accent-text);
  }

  @media (max-width: 1080px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
      max-width: 640px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .plans {
      margin-top: -140px;
    }

    .plan {
      padding: 24px;
    }
  }
</style>
