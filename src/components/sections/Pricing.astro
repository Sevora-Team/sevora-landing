---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { formatPrice, planPrice, prices } from '@/data/pricing';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

// The plans on the plans page as a ladder: three steps, each a little higher, the top step lit.
// The billing toggle that switches the prices sits in the page hero above.
const lang = getLangFromUrl(Astro.url);
const { pricing } = useTranslations(lang);

const plans = [
  { ...pricing.plans.free, price: undefined, featured: false },
  { ...pricing.plans.starter, price: planPrice(prices[lang].starter, lang), featured: false },
  { ...pricing.plans.premium, price: planPrice(prices[lang].premium, lang), featured: true },
];
---

<section class="pricing" id="paketi">
  <div class="wrap">
    <div class="ladder">
      {plans.map(({ name, description, items, cta, price, featured }, i) => (
        <article
          class:list={['plan', 'rise', { featured }]}
          style={`--delay: ${0.3 + i * 0.08}s; --step: ${i}`}
        >
          <header class="head">
            <h2 class="name">{name}</h2>
            <p class="body-sm description">{description}</p>
          </header>
          <div class="cost">
            {price ? (
              <>
                <p class="price when-monthly">
                  <strong>{price.monthly}</strong>
                  <span class="per">{pricing.perMonth}</span>
                </p>
                <p class="price when-yearly">
                  <strong>{price.yearly}</strong>
                  <span class="per">
                    <s>{price.monthly}</s> {pricing.perMonth}
                  </span>
                </p>
                <p class="caption when-monthly">{pricing.noteMonthly}</p>
                <p class="caption when-yearly">{pricing.noteYearly(price.yearlyTotal)}</p>
              </>
            ) : (
              <>
                <p class="price">
                  <strong>{formatPrice(0, lang)}</strong>
                  <span class="per">{pricing.forever}</span>
                </p>
                <p class="caption">{pricing.noteFree}</p>
              </>
            )}
          </div>
          <Button class="cta" href={links.signup} variant={featured ? 'primary' : 'ghost'}>
            {cta}
          </Button>
          <ul class="features" aria-label={pricing.included}>
            {items.map((item) => (
              <li>
                <Icon name="check" size={18} class="check" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: 56px 24px;
  }

  /* Three steps, each starting a little higher than the one before; the bottoms line up. */
  .ladder {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .plan {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 24px;
    margin-top: calc((2 - var(--step)) * 32px);
    padding: 36px 36px 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: rgb(12 21 32 / 0.55);
  }

  .featured {
    position: relative;
    border-color: var(--teal-line);
    background: var(--teal-grad);
  }

  /* The day line runs along the top of the lit step. */
  .featured::before {
    content: '';
    position: absolute;
    inset: 0 24px auto;
    height: 1px;
    background: var(--day-line-x);
  }

  .name {
    margin: 0;
    font: 700 28px/32px var(--font-display);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .description {
    margin-top: 6px;
  }

  .cost {
    display: grid;
    gap: 6px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .featured .cost {
    border-color: var(--teal-line);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0;
  }

  .price strong {
    font: 700 48px/52px var(--font-display);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .per {
    font: 400 15px/20px var(--font-sans);
    color: var(--text-muted);
  }

  .per s {
    margin-right: 4px;
  }

  .cta {
    justify-content: center;
  }

  .features {
    display: grid;
    align-content: start;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--text-body);
    font-size: 15px;
    line-height: 23px;
  }

  .featured .features li {
    color: var(--text);
  }

  .check {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }

  @media (max-width: 1080px) {
    .ladder {
      grid-template-columns: minmax(0, 1fr);
      max-width: 620px;
      margin-inline: auto;
    }

    .plan {
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .pricing {
      padding-top: 40px;
    }

    .plan {
      gap: 20px;
      padding: 28px 22px 30px;
    }

    .price strong {
      font-size: 40px;
      line-height: 44px;
    }
  }
</style>
