---
// The opening: the promise over a gold horizon, then the dash's Gold screen as the proof,
// tilted back until it scrolls into view, and the market ticker.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import PriceCell from '@/components/ui/PriceCell.astro';
import { links } from '@/data/links';
import { changePercent, GOLD, instruments, ticker } from '@/data/markets';
import { numberLocales } from '@/i18n/locales';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { buildChart, CHART_HEIGHT, CHART_WIDTH } from '@/lib/chart';
import { formatNumber } from '@/lib/format';

const lang = getLangFromUrl(Astro.url);
const { hero: t, dash, sample } = useTranslations(lang);
const locale = numberLocales[lang];

const gold = instruments.find(({ symbol }) => symbol === GOLD) ?? instruments[0];
const chart = buildChart(gold);
const format = (v: number) => formatNumber(v, gold.decimals, locale);
const bands = [
  { label: 'R2', value: gold.levels.r2, mark: chart.levels.r2, tone: 'down' },
  { label: 'R1', value: gold.levels.r1, mark: chart.levels.r1, tone: 'down' },
  { label: 'P', value: gold.levels.pivot, mark: chart.levels.pivot, tone: 'neutral' },
  { label: 'S1', value: gold.levels.s1, mark: chart.levels.s1, tone: 'up' },
];

// Sidebar icons, in the order of the dash's navigation groups.
const groupIcons: IconName[][] = [
  ['stacked-line-chart', 'call-split', 'calendar-month'],
  ['menu-book', 'notifications'],
  ['psychology', 'school'],
];
---

<section class="hero" id="top" data-theme="dark">
  <div class="horizon" aria-hidden="true"></div>

  <div class="wrap intro">
    <p class="now rise">
      <span class="time">07:45</span>
      {t.now}
    </p>
    <h1 class="display rise" style="--delay: 0.06s">
      {t.title.before}
      <span class="gold">{t.title.gold}</span>
      {t.title.after}
    </h1>
    <p class="lead rise" style="--delay: 0.12s">
      {t.lead}
    </p>
    <div class="btn-row rise" style="--delay: 0.18s">
      <Button href={links.signup}>{t.primary}</Button>
      <Button href="#dan" variant="ghost" icon="north-east">
        {t.secondary}
      </Button>
    </div>
  </div>

  <div class="wrap stage">
    <div class="frame">
      <div
        class="dash"
        role="img"
        aria-label={t.dashLabel}
        data-symbol={gold.symbol}
        data-last={gold.last}
        data-prev={gold.prev}
        data-span={gold.levels.r2 - gold.levels.s1}
      >
        <div class="side">
          <span class="brand">SEVORA</span>
          <span class="item">
            <Icon name="insights" size={16} />
            {dash.overview}
          </span>
          {dash.groups.map(({ label, items }, g) => (
            <>
              <span class="group">{label}</span>
              {items.map((item, i) => (
                <span class:list={['item', { on: g === 0 && i === 0 }]}>
                  <Icon name={groupIcons[g][i]} size={16} />
                  {item}
                </span>
              ))}
            </>
          ))}
        </div>

        <div class="main">
          <div class="head">
            <div>
              <p class="live">
                <span></span>
                {gold.symbol} · {dash.live}
              </p>
              <PriceCell
                value={gold.last}
                change={changePercent(gold)}
                decimals={gold.decimals}
                lang={lang}
                gold
                size="lg"
                quote={gold.symbol}
              />
            </div>
            <dl class="meta">
              <div>
                <dt>{dash.range}</dt>
                <dd>
                  {format(gold.levels.s1)} – {format(gold.levels.r1)}
                </dd>
              </div>
              <div>
                <dt>{dash.atr}</dt>
                <dd>{formatNumber(38.6, 1, locale)}</dd>
              </div>
              <div>
                <dt>{dash.bias}</dt>
                <dd class="long">{dash.biasValue}</dd>
              </div>
            </dl>
            <div class="actions">
              <span class="action primary">{dash.makePlan}</span>
              <span class="action">{dash.setAlert}</span>
            </div>
          </div>

          <div class="cols">
            <div class="card">
              <p class="card-title">{dash.chart}</p>
              <div class="chart">
                <svg viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`} preserveAspectRatio="none">
                  {bands.map(({ mark, tone }) => (
                    <rect
                      class:list={['band', tone]}
                      x="0"
                      y={mark.y - 5}
                      width={CHART_WIDTH}
                      height="10"
                    />
                  ))}
                  <path class="wick-up" d={chart.wicksUp}></path>
                  <path class="wick-down" d={chart.wicksDown}></path>
                  <path class="body-up" d={chart.bodiesUp}></path>
                  <path class="body-down" d={chart.bodiesDown}></path>
                  <line
                    class="last"
                    x1="0"
                    x2={CHART_WIDTH}
                    y1={chart.last.y}
                    y2={chart.last.y}
                  ></line>
                </svg>
                <div class="tags">
                  {bands.map(({ label, value, mark, tone }) => (
                    <span class:list={['tag', tone]} style={`top: ${mark.percent}%`}>
                      {label} {format(value)}
                    </span>
                  ))}
                  <span class="tag tag-last" style={`top: ${chart.last.percent}%`}>
                    {format(gold.last)}
                  </span>
                </div>
              </div>
            </div>

            <div class="aside">
              <div class="card summary">
                <p class="card-title">{dash.summaryTitle}</p>
                <p>{dash.summary}</p>
                <p class="updated">{dash.updated}</p>
              </div>
              <div class="card">
                <p class="card-title">{dash.planTitle}</p>
                <ol class="plan">
                  {dash.plan.map((step) => (
                    <li>{step}</li>
                  ))}
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="caption note">{t.dashNote}</p>
  </div>

  <div class="ticker">
    <p class="caption">{t.tickerTitle}</p>
    <div class="marquee">
      <ul class="marquee-track">
        {[false, true].map((duplicate) =>
          ticker.map(({ symbol, value, change, decimals }) => (
            <li aria-hidden={duplicate ? 'true' : undefined}>
              <span class="mono-label">{symbol}</span>
              <PriceCell
                value={value}
                change={change}
                decimals={decimals}
                lang={lang}
                gold={symbol === GOLD}
                quote={symbol === GOLD ? symbol : undefined}
              />
            </li>
          )),
        )}
      </ul>
    </div>
    <p class="sr-only">{sample}</p>
  </div>
</section>

<script>
  import { numberLocales } from '@/i18n/locales';
  import { formatChange, formatNumber } from '@/lib/format';

  // Sample gold ticks: drift toward the last price with small noise, in the dash and the ticker.
  const dash = document.querySelector<HTMLElement>('.hero .dash');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dash && !reduced) {
    const { symbol = '', last, prev, span } = dash.dataset;
    const target = Number(last);
    const locale = numberLocales[document.documentElement.lang.startsWith('en') ? 'en' : 'sr'];
    let current = target;

    setInterval(() => {
      if (document.hidden) return;
      const next =
        current + (target - current) * 0.18 + (Math.random() - 0.5) * Number(span) * 0.012;
      const change = Math.round(((next - Number(prev)) / Number(prev)) * 10000) / 100;

      document.querySelectorAll<HTMLElement>(`[data-quote="${symbol}"]`).forEach((cell) => {
        const decimals = Number(cell.dataset.decimals);
        const value = cell.querySelector('[data-value]');
        const changeText = cell.querySelector('[data-change]');
        if (value) value.textContent = formatNumber(next, decimals, locale);
        if (changeText) changeText.textContent = formatChange(change, locale);
        cell.classList.toggle('tick-up', next > current);
        cell.classList.toggle('tick-down', next < current);
        setTimeout(() => cell.classList.remove('tick-up', 'tick-down'), 200);
      });
      current = next;
    }, 2600);
  }
</script>

<style>
  @keyframes rise-horizon {
    from {
      opacity: 0;
      translate: 0 120px;
    }
  }

  @keyframes flatten {
    to {
      transform: none;
    }
  }

  @keyframes reveal-chart {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Slides under the sticky header. Clipped so the horizon's glow stays inside. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-top: -84px;
    padding-top: 172px;
    text-align: center;
  }

  /* A faint dot grid around the headline. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(rgb(124 137 150 / 0.16) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 50% at 50% 20%, #000 30%, transparent 75%);
  }

  /* The gold sunrise: the top edge of a huge ellipse, rising behind the dash. */
  .horizon {
    position: absolute;
    top: 680px;
    left: 50%;
    z-index: -1;
    width: 2400px;
    height: 1400px;
    margin-left: -1200px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--page) 97%, transparent 100%);
    box-shadow:
      0 -2px 0 0 var(--horizon-gold),
      0 -14px 60px 6px var(--horizon-gold-glow);
    animation: rise-horizon 2.2s var(--ease-out) both;
  }

  .intro {
    display: grid;
    justify-items: center;
  }

  .now {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 6px 14px 6px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: rgb(7 13 22 / 0.7);
    font-size: 14px;
    line-height: 20px;
  }

  .time {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--price);
    color: var(--ink);
    font: 500 12px/16px var(--font-mono);
  }

  .display {
    max-width: 12ch;
    margin-top: 28px;
    font-size: clamp(48px, 8.4vw, 120px);
    line-height: 0.92;
  }

  .gold {
    color: var(--price);
  }

  .lead {
    max-width: 52ch;
    margin-top: 28px;
    font-size: 20px;
    line-height: 31px;
  }

  .btn-row {
    justify-content: center;
    margin-top: 40px;
  }

  .stage {
    margin-top: 80px;
    perspective: 1400px;
  }

  .frame {
    max-width: 1180px;
    margin-inline: auto;
    padding: 10px;
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgb(66 202 215 / 0.28),
      rgb(30 46 61 / 0.6) 30%,
      rgb(30 46 61 / 0.25)
    );
    box-shadow: 0 50px 100px -30px rgb(0 0 0 / 0.85);
    transform-origin: 50% 0;
  }

  /* Tilted back, it lies flat by the time it is half in view. */
  @supports (animation-timeline: view()) {
    .frame {
      transform: rotateX(18deg) scale(0.94);
      animation-name: flatten;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }

  .dash {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--page);
    font-size: 13px;
    line-height: 19px;
    text-align: left;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 12px;
    border-right: 1px solid var(--border);
    background: var(--ink);
  }

  .brand {
    padding: 0 8px 14px;
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: var(--radius-sm);
  }

  .item.on {
    background: var(--surface-hover);
    color: var(--text);
  }

  .group {
    padding: 10px 10px 2px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .main {
    display: grid;
    gap: 14px;
    min-width: 0;
    padding: 18px 20px;
  }

  .head,
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 6px;
    font: 500 12px/16px var(--font-mono);
  }

  .live span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--up);
  }

  .meta {
    display: flex;
    gap: 22px;
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
  }

  .meta dd {
    margin: 0;
    color: var(--text);
    font: 500 13px/18px var(--font-mono);
  }

  .meta .long {
    color: var(--up);
  }

  .actions {
    display: flex;
    gap: 6px;
  }

  .action {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 12px;
  }

  .action.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 14px;
  }

  .card {
    padding: 14px 16px;
  }

  .card-title {
    margin: 0 0 8px;
    color: var(--text);
    font-weight: 600;
  }

  .chart {
    position: relative;
    height: 230px;
  }

  .chart svg {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(100% - 92px);
    height: 100%;
    overflow: visible;
    animation: reveal-chart 1.6s var(--ease) 0.4s both;
  }

  .chart svg * {
    vector-effect: non-scaling-stroke;
  }

  .band.down {
    fill: rgb(240 97 109 / 0.14);
  }

  .band.up {
    fill: rgb(61 214 140 / 0.14);
  }

  .band.neutral {
    fill: rgb(169 180 191 / 0.12);
  }

  .wick-up {
    stroke: var(--up);
  }

  .wick-down {
    stroke: var(--down);
  }

  .body-up {
    fill: var(--up);
  }

  .body-down {
    fill: var(--down);
  }

  .last {
    stroke: var(--price);
    stroke-dasharray: 2 4;
    opacity: 0.8;
  }

  .tags {
    position: absolute;
    inset: 0 0 0 auto;
    width: 88px;
  }

  .tag {
    position: absolute;
    right: 0;
    padding: 1px 6px;
    font: 500 12px/16px var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .tag.down {
    color: var(--down);
  }

  .tag.up {
    color: var(--up);
  }

  .tag.neutral {
    color: var(--text-body);
  }

  .tag-last {
    border-radius: var(--radius-xs);
    background: var(--price);
    color: var(--ink);
  }

  .aside {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .summary {
    border-color: var(--teal-line);
    background: var(--teal-grad);
    color: var(--text);
    font-size: 14px;
    line-height: 21px;
  }

  .summary p {
    margin: 0;
  }

  .summary .card-title {
    margin-bottom: 6px;
    color: var(--accent-hover);
    font-size: 12px;
  }

  .summary .updated {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 12px;
  }

  .plan {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    font-size: 12px;
    line-height: 17px;
  }

  .plan li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 8px;
    counter-increment: step;
  }

  .plan li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--surface-hover);
    color: var(--text);
    font: 500 10px/1 var(--font-mono);
  }

  .note {
    margin-top: 16px;
  }

  .ticker {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin-top: 96px;
    padding: 28px 0 32px;
    border-block: 1px solid var(--border);
  }

  .marquee {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 56px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-track li {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 10px;
  }

  @media (max-width: 1080px) {
    .dash {
      grid-template-columns: minmax(0, 1fr);
    }

    .side,
    .actions {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      margin-top: -68px;
      padding-top: 120px;
    }

    .horizon {
      top: 700px;
    }

    .lead {
      font-size: 17px;
      line-height: 27px;
    }

    .btn-row {
      align-self: stretch;
    }

    .btn-row > * {
      flex: 1 1 100%;
      justify-content: center;
    }

    .stage {
      margin-top: 56px;
    }

    .main {
      padding: 12px;
    }

    .meta {
      display: none;
    }

    .cols {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart {
      height: 180px;
    }

    .ticker {
      margin-top: 64px;
    }

    .marquee-track {
      gap: 36px;
    }
  }
</style>
