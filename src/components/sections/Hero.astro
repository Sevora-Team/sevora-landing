---
import { getImage, Image } from 'astro:assets';
import photo from '@/assets/photos/heroes/home.webp';
import photoMobile from '@/assets/photos/heroes/home-mobile.webp';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
// Phones get a portrait crop with the subject higher up.
const mobile = await getImage({ src: photoMobile, width: 800 });
---

<section class="hero section-dark" id="top" data-theme="dark">
  <picture class="photo">
    <source media="(max-width: 640px)" srcset={mobile.src} />
    <Image
      src={photo}
      alt=""
      widths={[960, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <div class="wrap content">
    <h1 class="display rise">{t.hero.title}</h1>
    <p class="lead rise" style="--delay: 0.08s">
      {t.hero.lead}
    </p>
    <div class="btn-row rise" style="--delay: 0.16s">
      <Button href={links.signup}>{t.hero.primary}</Button>
      <Button href="#platforma" variant="ghost" icon="north-east">
        {t.hero.secondary}
      </Button>
    </div>
    <p class="markets caption rise" style="--delay: 0.24s">
      {t.hero.markets}
    </p>
  </div>

  <a class="scroll-cue" href="#o-nama" aria-label={t.hero.scrollCue}>
    <span class="mouse" aria-hidden="true">
      <span></span>
    </span>
    <Icon name="swipe-up" size={28} class="swipe" />
    <span class="cue-scroll" aria-hidden="true">
      {t.hero.scroll}
    </span>
    <span class="cue-swipe" aria-hidden="true">
      {t.hero.swipe}
    </span>
  </a>
</section>

<style>
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(1.12) translateX(48px);
    }
  }

  @keyframes photo-drift {
    to {
      translate: 0 160px;
    }
  }

  @keyframes content-out {
    to {
      opacity: 0;
      translate: 0 -64px;
    }
  }

  @keyframes wheel {
    70% {
      transform: translateY(11px);
      opacity: 0;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes swipe {
    0%,
    100% {
      transform: translateY(5px);
      opacity: 0.55;
    }

    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  /* Fills the viewport; slides under the sticky header. */
  .hero {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100svh;
    min-height: 640px;
    max-height: 1200px;
    margin-top: -84px;
    padding-top: 84px;
    background: var(--bg);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 75% at 0% 100%, var(--haze), transparent 70%),
      radial-gradient(45% 55% at 100% 0%, rgb(22 164 173 / 0.16), transparent 70%);
  }

  /* The bottom melts into the page backdrop. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    height: 260px;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(5 9 15 / 0), var(--page));
  }

  .photo img {
    animation: photo-in 1.4s var(--ease-out) both;
  }

  /* Darkens the left for the text and the top and bottom edges. */
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(3 6 12 / 0.95) 0%,
        rgb(3 6 12 / 0.78) 30%,
        rgb(3 6 12 / 0.25) 58%,
        rgb(3 6 12 / 0) 80%
      ),
      linear-gradient(
        180deg,
        rgb(3 6 12 / 0.6) 0%,
        rgb(3 6 12 / 0) 20%,
        rgb(3 6 12 / 0) 72%,
        rgb(3 6 12 / 0.75) 100%
      );
    animation: fade 1.2s ease both;
  }

  .content {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-bottom: 96px;
  }

  /* The photo drifts down and the text lifts away as the hero scrolls out. */
  @supports (animation-timeline: scroll()) {
    .photo,
    .content {
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }

    .photo {
      animation-name: photo-drift;
      animation-range: 0 900px;
    }

    .content {
      animation-name: content-out;
      animation-range: 0 70vh;
    }
  }

  .display {
    max-width: 13ch;
    font-size: 72px;
    line-height: 76px;
  }

  .lead {
    max-width: 44ch;
    margin-top: 24px;
  }

  .btn-row {
    margin-top: 36px;
  }

  .markets {
    margin-top: 32px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .scroll-cue {
    position: absolute;
    bottom: 26px;
    left: 50%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font: 500 11px/14px var(--font-mono);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: color 0.25s var(--ease);
    animation: fade 1s var(--ease) 0.6s both;
  }

  .scroll-cue:hover {
    color: var(--text);
  }

  .mouse {
    display: flex;
    justify-content: center;
    width: 24px;
    height: 38px;
    padding-top: 7px;
    border: 1.5px solid var(--border-strong);
    border-radius: 14px;
    transition: border-color 0.25s var(--ease);
  }

  .scroll-cue:hover .mouse {
    border-color: var(--text-muted);
  }

  .mouse span {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    animation: wheel 1.9s var(--ease) infinite;
  }

  .swipe {
    color: var(--accent);
    animation: swipe 1.9s ease-in-out infinite;
  }

  .swipe,
  .cue-swipe {
    display: none;
  }

  @media (max-width: 1080px) {
    .display {
      font-size: 56px;
      line-height: 60px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 600px;
      max-height: 900px;
      margin-top: -68px;
      padding-top: 68px;
    }

    .photo::after {
      background: linear-gradient(
        180deg,
        rgb(3 6 12 / 0.95) 0%,
        rgb(3 6 12 / 0.75) 42%,
        rgb(3 6 12 / 0.15) 70%,
        rgb(3 6 12 / 0.7) 100%
      );
    }

    .content {
      justify-content: flex-start;
      padding-top: 40px;
      padding-bottom: 0;
    }

    .display {
      font-size: 40px;
      line-height: 46px;
    }

    .btn-row {
      align-self: stretch;
    }

    .btn-row > * {
      flex: 1 1 100%;
      justify-content: center;
    }

    .scroll-cue {
      bottom: 112px;
    }

    .mouse,
    .cue-scroll {
      display: none;
    }

    .swipe,
    .cue-swipe {
      display: block;
    }
  }
</style>
