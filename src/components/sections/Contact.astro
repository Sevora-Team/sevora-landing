---
import { PUBLIC_CONTACT_ENDPOINT } from 'astro:env/client';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import TextField from '@/components/ui/TextField.astro';
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { contact, contactPage } = useTranslations(lang);
---

<section class="section contact" id="poruka">
  <div class="wrap layout">
    <div class="intro reveal-left">
      <h2 class="h2">{contact.title}</h2>
      <p class="lead">{contact.lead}</p>
      <ol class="next">
        {contactPage.next.map(({ title, text }, i) => (
          <li class="reveal-left">
            <span class="number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="next-title">{title}</p>
              <p class="body-sm">{text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="fast reveal" href={links.discord}>
        <span class="icon-circle">
          <Icon name="forum" />
        </span>
        <span class="fast-text">
          <strong>{contactPage.fast.title}</strong>
          <span class="caption">{contactPage.fast.note}</span>
        </span>
        <Icon name="north-east" class="fast-arrow" />
      </a>
    </div>

    <div class="card reveal-right">
      <form class="form" method="post" action={PUBLIC_CONTACT_ENDPOINT}>
        <input type="hidden" name="lang" value={lang} />
        <!-- Spam trap: hidden from people, filled in by bots. -->
        <div class="trap" aria-hidden="true">
          <label>
            {contact.trap}
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <div class="row">
          <TextField
            label={contact.firstName}
            name="firstName"
            autocomplete="given-name"
            placeholder={contact.firstNamePlaceholder}
            required
          />
          <TextField
            label={contact.lastName}
            name="lastName"
            autocomplete="family-name"
            placeholder={contact.lastNamePlaceholder}
            required
          />
        </div>
        <div class="row">
          <TextField
            label={contact.email}
            name="email"
            type="email"
            autocomplete="email"
            placeholder={contact.emailPlaceholder}
            required
          />
          <TextField
            label={contact.phone}
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            placeholder={contact.phonePlaceholder}
            hint={contact.phoneHint}
          />
        </div>

        <div class="select">
          <label for="field-topic">{contact.topic}</label>
          <div class="select-box">
            <select id="field-topic" name="topic" required>
              <option value="">{contact.topicPlaceholder}</option>
              {contact.topics.map((topic) => (
                <option value={topic}>{topic}</option>
              ))}
            </select>
            <Icon name="expand-more" class="chevron" />
          </div>
        </div>

        <TextField
          label={contact.message}
          name="message"
          multiline
          rows={6}
          placeholder={contact.messagePlaceholder}
          required
        />

        <div class="foot">
          <p class="caption consent">
            {contact.consent.before}
            <a href={links.privacy}>{contact.consent.link}</a>
            {contact.consent.after}
          </p>
          <Button type="submit" icon="north-east" data-sending={contact.sending}>
            {contact.send}
          </Button>
        </div>
        <p class="error" role="alert" hidden>
          <Icon name="info" size={16} />
          {contact.error}
        </p>
      </form>

      <div class="done" role="status" hidden>
        <Icon name="check-circle" size={44} class="done-icon" />
        <h3 class="h3">{contact.doneTitle}</h3>
        <p class="body-sm">{contact.doneText}</p>
        <Button variant="ghost" size="sm" class="again">
          {contact.again}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  const area = document.querySelector<HTMLElement>('#poruka');
  const form = area?.querySelector<HTMLFormElement>('form');
  const done = area?.querySelector<HTMLElement>('.done');
  const error = area?.querySelector<HTMLElement>('.error');
  const submit = form?.querySelector<HTMLButtonElement>('[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !done || !error || !submit) return;

    const label = submit.innerHTML;
    submit.disabled = true;
    submit.textContent = submit.dataset.sending ?? '';
    error.hidden = true;

    try {
      // A filled spam trap gets the success state without anything being sent.
      const trapped = Boolean(new FormData(form).get('website'));
      // `action` falls back to this page when no endpoint is configured; only send to a real one.
      if (!trapped && !form.getAttribute('action'))
        throw new Error('No contact endpoint configured');
      const response = trapped
        ? new Response()
        : await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
      if (!response.ok) throw new Error(`Contact endpoint responded ${response.status}`);
      form.hidden = true;
      done.hidden = false;
      form.reset();
    } catch (cause) {
      console.error(cause);
      error.hidden = false;
    } finally {
      submit.disabled = false;
      submit.innerHTML = label;
    }
  });

  done?.querySelector('.again')?.addEventListener('click', () => {
    if (!form || !done) return;
    done.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLElement>('#field-firstName')?.focus();
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: start;
    gap: 72px;
  }

  .intro {
    position: sticky;
    top: 120px;
    gap: 22px;
  }

  /* What happens after sending: numbered steps on a fading line. */
  .next {
    position: relative;
    display: grid;
    margin: 14px 0 6px;
    padding: 0;
    list-style: none;
  }

  .next::before {
    content: '';
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 19px;
    width: 1px;
    background: linear-gradient(180deg, rgb(66 202 215 / 0.5), rgb(66 202 215 / 0.08));
  }

  .next li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    animation-range: entry 10% cover 35%;
  }

  .next li:nth-child(2) {
    animation-range: entry 16% cover 41%;
  }

  .next li:nth-child(3) {
    animation-range: entry 22% cover 47%;
  }

  .number {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(66 202 215 / 0.28);
    border-radius: 50%;
    background: var(--bg);
    color: var(--accent);
    font: 400 12px/1 var(--font-mono);
  }

  .next-title {
    margin: 8px 0 4px;
    color: var(--text);
    font: 600 15px/22px var(--font-sans);
  }

  /* The Discord shortcut for urgent questions. */
  .fast {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid rgb(66 202 215 / 0.22);
    border-radius: 18px;
    background: linear-gradient(135deg, rgb(22 164 173 / 0.16), rgb(22 164 173 / 0.03));
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .fast:hover {
    border-color: rgb(66 202 215 / 0.45);
    transform: translateY(-2px);
  }

  .fast-text {
    display: grid;
    gap: 2px;
  }

  .fast-text strong {
    color: var(--text);
    font: 600 15px/22px var(--font-sans);
  }

  .fast-arrow {
    color: var(--accent);
  }

  .card {
    padding: 44px;
    border: 1px solid var(--teal-line-soft);
    border-radius: var(--radius-card);
    background: var(--teal-glass);
  }

  .form {
    display: grid;
    gap: 28px;
  }

  .form[hidden] {
    display: none;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  .select {
    display: grid;
    gap: 6px;
  }

  .select label {
    color: var(--text);
    font: 500 14px/20px var(--font-sans);
  }

  .select-box {
    position: relative;
  }

  select {
    width: 100%;
    padding: 11px 40px 11px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font: 400 14px/22px var(--font-sans);
    appearance: none;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  select:hover,
  select:focus {
    border-color: var(--accent-border);
  }

  /* The placeholder option reads like a placeholder until a topic is chosen. */
  select:invalid {
    color: var(--text-muted);
  }

  option {
    color: var(--text);
  }

  .chevron {
    position: absolute;
    top: 50%;
    right: 12px;
    color: var(--text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .consent {
    max-width: 40ch;
  }

  .consent a {
    color: var(--text);
  }

  .trap {
    position: absolute;
    left: -9999px;
  }

  .error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--danger);
    font: 400 14px/20px var(--font-sans);
  }

  .error[hidden] {
    display: none;
  }

  .done {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 12px;
    min-height: 440px;
    animation: rise 0.5s var(--ease) both;
  }

  .done[hidden] {
    display: none;
  }

  .done-icon {
    color: var(--accent-text);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .intro {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .card {
      padding: 22px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .foot > * {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
