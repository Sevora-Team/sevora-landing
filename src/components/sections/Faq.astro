---
import FaqList from '@/components/ui/FaqList.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { faq } = useTranslations(getLangFromUrl(Astro.url));
---

<section class="section faq" id="pitanja">
  <div class="wrap">
    <h2 class="h2 reveal">{faq.title}</h2>
    <FaqList items={faq.items} name="faq" size="lg" />
  </div>
</section>

<style>
  /* Follows the pricing teaser, which already ends with section padding. */
  .faq {
    padding-top: 0;
  }

  h2 {
    margin-bottom: 56px;
    text-align: center;
  }
</style>
