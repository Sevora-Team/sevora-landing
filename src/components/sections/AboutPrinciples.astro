---
// The four principles, all in view: what each one means and what it commits us to.
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { principles } = useTranslations(getLangFromUrl(Astro.url)).aboutPage;
const icons: IconName[] = ['visibility', 'shield', 'translate', 'verified-user'];
---

<section class="section" id="principi">
  <div class="wrap">
    <div class="intro head">
      <h2 class="h2">{principles.title}</h2>
      <p class="lead">{principles.lead}</p>
    </div>

    <ul class="principles">
      {principles.items.map(({ title, text, points }, i) => (
        <li class="principle">
          <Icon name={icons[i]} size={28} class="icon" />
          <h3 class="title">{title}</h3>
          <p>{text}</p>
          <ul class="points">
            {points.map((point) => (
              <li>
                <Icon name="check" size={16} />
                {point}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
    margin-bottom: 56px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 72px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 36px 0 48px;
    border-top: 1px solid var(--border);
  }

  .principle :global(.icon) {
    color: var(--accent-text);
  }

  .title {
    margin: 4px 0 0;
    color: var(--text);
    font: 700 28px/34px var(--font-display);
    letter-spacing: -0.02em;
  }

  .principle > p {
    max-width: 52ch;
    margin: 0;
    font-size: 17px;
    line-height: 27px;
  }

  .points {
    display: grid;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font: 400 15px/22px var(--font-sans);
  }

  .points :global(svg) {
    flex: none;
    color: var(--accent-text);
  }

  @media (max-width: 860px) {
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .head {
      margin-bottom: 32px;
    }

    .principle {
      padding: 28px 0 36px;
    }

    .title {
      font-size: 24px;
      line-height: 30px;
    }
  }
</style>
