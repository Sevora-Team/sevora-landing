---
// One card per Academy level. The card gets darker as the plan that includes it gets higher:
// free levels white, Starter grey, Premium dark. Each card opens to its modules and lessons.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels, levelPlan } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { level: copy } = t.academyPage;
const levels = (await getLevels()).map((level) => ({
  ...level,
  plan: levelPlan(level.order),
}));
---

<section class="section levels">
  <div class="wrap list">
    {levels.map(({ id, order, label, title, goal, modules, lessonCount, plan }) => (
      <article
        class:list={['card', `plan-${plan}`]}
        data-theme={plan === 'premium' ? 'dark' : undefined}
        id={id}
        aria-labelledby={`${id}-title`}
      >
        <p class="num" aria-hidden="true">
          {order}
        </p>
        <div class="body">
          <span class="mono-label label">{label[lang]}</span>
          <h2 class="h2 title" id={`${id}-title`}>
            {title[lang]}
          </h2>
          <p>{goal[lang]}</p>
          <ul class="facts">
            <li>
              <Icon name="menu-book" size={18} />
              {copy.modules(modules.length)}
            </li>
            <li>
              <Icon name="play-circle" size={18} />
              {copy.lessons(lessonCount)}
            </li>
            <li>
              <Icon name="quiz" size={18} />
              {copy.check}
            </li>
          </ul>
        </div>
        <div class="side">
          <span class="tier">{t.pricing.plans[plan].name}</span>
          {plan === 'free' ? (
            <Button href={links.signup} size="sm">
              {copy.startFree}
            </Button>
          ) : (
            <Button href={getPageUrl(lang, 'plans')} variant="ghost" size="sm" icon="north-east">
              {copy.includedIn(t.pricing.plans[plan].name)}
            </Button>
          )}
        </div>
        <details class="modules" name="levels" open={order === 0}>
          <summary>
            {copy.toggle(modules.length)}
            <Icon name="expand-more" class="chevron" />
          </summary>
          <ol class="module-list">
            {modules.map(({ number, title, badge, lessons }) => (
              <li class="module">
                <span class="mono-label module-n">{String(number).padStart(2, '0')}</span>
                <strong>{title[lang]}</strong>
                <span class="medal">
                  <i>
                    <Icon name="workspace-premium" size={16} />
                  </i>
                  {badge[lang]}
                </span>
                <ol class="lessons">
                  {lessons.map(({ number, title }) => (
                    <li>
                      <span class="mono-label">{number}</span>
                      {title[lang]}
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        </details>
      </article>
    ))}
  </div>
</section>

<style>
  .levels {
    padding-top: 0;
  }

  .list {
    display: grid;
    gap: 16px;
  }

  .card {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px 40px;
    padding: 36px 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    scroll-margin-top: 100px;
    transition: border-color 0.25s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .plan-starter {
    border-color: transparent;
    background: var(--surface-hover);
  }

  .plan-premium {
    background: var(--bg);
  }

  .num {
    margin: 0;
    font: 400 104px/0.9 var(--font-sans);
    letter-spacing: -0.05em;
    color: var(--text);
  }

  .body {
    display: grid;
    gap: 12px;
  }

  .body p {
    max-width: 60ch;
    margin: 0;
  }

  .label {
    color: var(--accent-text);
    text-transform: uppercase;
  }

  .title {
    font-size: 36px;
    line-height: 44px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-body);
    font: 400 14px/20px var(--font-sans);
  }

  .facts :global(svg) {
    color: var(--accent-text);
  }

  .side {
    display: grid;
    justify-items: end;
    gap: 14px;
  }

  .tier {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--accent-subtle);
    color: var(--accent-text);
    font: 500 12px/16px var(--font-mono);
  }

  .modules {
    grid-column: 2 / -1;
    margin-top: 12px;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
    color: var(--accent-text);
    font: 500 14px/20px var(--font-sans);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    transition: transform 0.3s var(--ease);
  }

  .modules[open] .chevron {
    transform: rotate(180deg);
  }

  .module-list {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    animation: fade 0.35s var(--ease) both;
  }

  .module {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--surface-hover);
  }

  .plan-starter .module {
    background: var(--surface);
  }

  .module-n {
    color: var(--accent-text);
    font-size: 14px;
  }

  .module strong {
    color: var(--text);
    font: 400 16px/24px var(--font-sans);
  }

  .medal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 5px;
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    color: var(--text);
    font: 400 13px/18px var(--font-sans);
  }

  .medal i {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-subtle);
    color: var(--accent-text);
    font-style: normal;
  }

  .lessons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-column: 2 / -1;
    gap: 6px 24px;
    margin: 6px 0 2px;
    padding: 0;
    list-style: none;
  }

  .lessons li {
    display: flex;
    gap: 10px;
    color: var(--text-body);
    font-size: 14px;
    line-height: 20px;
  }

  .lessons .mono-label {
    flex: none;
    width: 32px;
  }

  @media (max-width: 1080px) {
    .card {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .side {
      grid-column: 2;
      justify-items: start;
    }

    .num {
      font-size: 72px;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 24px;
    }

    .side,
    .modules {
      grid-column: 1;
    }

    .num {
      font-size: 56px;
    }

    .title {
      font-size: 28px;
      line-height: 34px;
    }

    .module {
      grid-template-columns: 32px minmax(0, 1fr);
    }

    .medal {
      grid-column: 2;
      justify-self: start;
    }

    .lessons {
      grid-template-columns: minmax(0, 1fr);
      grid-column: 1 / -1;
    }
  }
</style>
