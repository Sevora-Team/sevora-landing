---
// The whole syllabus on one rail, from level 0 to 5, grouped by the plan that unlocks it. The
// rail is the home page's day line: gold at the start, teal at the end, filling as you scroll.
// Every module is listed; its lessons open under it.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels, levelPlan } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { level: copy } = t.academyPage;
const levels = await getLevels();
const tiers = (['free', 'starter', 'premium'] as const).map((plan) => ({
  plan,
  levels: levels.filter(({ order }) => levelPlan(order) === plan),
}));
---

<section class="section syllabus">
  <div class="wrap rail">
    {tiers.map(({ plan, levels: tierLevels }) => (
      <div class:list={['tier', `tier-${plan}`]}>
        <div class="tier-head">
          <span class="node" aria-hidden="true"></span>
          <p class="tier-name">
            {plan === 'free' ? t.academyBand.free : copy.includedIn(t.pricing.plans[plan].name)}
          </p>
          {plan === 'free' ? (
            <Button href={links.signup} size="sm">
              {copy.startFree}
            </Button>
          ) : (
            <Button href={getPageUrl(lang, 'plans')} variant="ghost" size="sm" icon="north-east">
              {t.actions.seePlans}
            </Button>
          )}
        </div>

        {tierLevels.map(({ id, order, label, title, goal, modules, lessonCount }) => (
          <article class="level" id={id} aria-labelledby={`${id}-title`}>
            <p class="num" aria-hidden="true">
              {order}
            </p>
            <div class="body">
              <h2 class="title" id={`${id}-title`}>
                <span class="sr-only">{label[lang]}: </span>
                {title[lang]}
              </h2>
              <p class="goal">{goal[lang]}</p>
              <p class="facts">
                {copy.modules(modules.length)}, {copy.lessons(lessonCount)}, {copy.check}
              </p>
              <ol class="modules">
                {modules.map(({ number, title: moduleTitle, badge, lessons }) => (
                  <li>
                    <details>
                      <summary>
                        <span class="module-n">{number}</span>
                        <span class="module-title">{moduleTitle[lang]}</span>
                        <span class="badge">
                          <Icon name="workspace-premium" size={16} />
                          {badge[lang]}
                        </span>
                        <Icon name="expand-more" class="chevron" />
                      </summary>
                      <ol class="lessons">
                        {lessons.map(({ number: lessonNumber, title: lessonTitle }) => (
                          <li>
                            <span class="lesson-n">{lessonNumber}</span>
                            {lessonTitle[lang]}
                          </li>
                        ))}
                      </ol>
                    </details>
                  </li>
                ))}
              </ol>
            </div>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes fill-rail {
    from {
      scale: 1 0;
    }
  }

  .syllabus {
    padding-top: 96px;
  }

  .rail {
    --col: 120px;

    position: relative;
    display: grid;
    gap: 40px;
  }

  /* The track, and the day line filling it as the syllabus scrolls by. */
  .rail::before,
  .rail::after {
    content: '';
    position: absolute;
    top: 14px;
    bottom: 0;
    left: calc(var(--gutter) + 13px);
    width: 2px;
    border-radius: 2px;
  }

  .rail::before {
    background: var(--border);
  }

  .rail::after {
    background: var(--day-line);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    /* Filled down to the middle of the screen: from the rail's top reaching it to its end. */
    .rail::after {
      animation-name: fill-rail;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: cover 50vh cover calc(100% - 50vh);
    }
  }

  .tier {
    display: grid;
    gap: 40px;
  }

  .tier-head {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding-left: var(--col);
  }

  .node {
    position: absolute;
    top: 50%;
    left: 6px;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--page);
  }

  .tier-free .node {
    border-color: var(--price);
  }

  .tier-name {
    margin: 0;
    color: var(--text);
    font: 700 22px/28px var(--font-display);
    letter-spacing: -0.01em;
  }

  .level {
    display: grid;
    grid-template-columns: var(--col) minmax(0, 1fr);
    scroll-margin-top: 100px;
  }

  .num {
    margin: 0;
    padding-left: 44px;
    color: var(--text);
    font: 700 56px/0.9 var(--font-display);
    letter-spacing: -0.04em;
  }

  .body {
    display: grid;
    gap: 12px;
    padding-bottom: 8px;
  }

  .title {
    margin: 0;
    color: var(--text);
    font: 700 40px/44px var(--font-display);
    letter-spacing: -0.03em;
  }

  .goal {
    max-width: 62ch;
    margin: 0;
    font-size: 17px;
    line-height: 27px;
  }

  .facts {
    margin: 0;
    color: var(--text-muted);
    font: 400 14px/20px var(--font-sans);
  }

  .modules {
    margin: 16px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .modules > li {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto 24px;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .module-n {
    color: var(--accent-text);
    font: 500 14px/20px var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .module-title {
    color: var(--text);
    font: 500 17px/24px var(--font-sans);
  }

  summary:hover .module-title {
    color: var(--accent-hover);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font: 400 13px/18px var(--font-sans);
  }

  .badge :global(svg) {
    color: var(--price);
  }

  .chevron {
    color: var(--text-muted);
    transition: transform 0.3s var(--ease);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .lessons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 32px;
    margin: 0;
    padding: 0 40px 22px 56px;
    list-style: none;
    animation: fade 0.35s var(--ease) both;
  }

  .lessons li {
    display: flex;
    gap: 12px;
    color: var(--text-body);
    font-size: 15px;
    line-height: 22px;
  }

  .lesson-n {
    flex: none;
    width: 30px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1080px) {
    .badge {
      display: none;
    }

    summary {
      grid-template-columns: 40px minmax(0, 1fr) 24px;
    }

    .lessons {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .syllabus {
      padding-top: 64px;
    }

    .rail {
      --col: 52px;
    }

    .rail::before,
    .rail::after {
      left: 29px;
    }

    .num {
      padding: 2px 0 0 26px;
      font-size: 28px;
    }

    .title {
      font-size: 28px;
      line-height: 32px;
    }

    summary {
      grid-template-columns: 28px minmax(0, 1fr) 24px;
      gap: 10px;
    }

    .lessons {
      padding: 0 0 18px 38px;
    }
  }
</style>
