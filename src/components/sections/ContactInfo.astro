---
// Support hours, weekend cover and response time, as a ruled list of reference facts.
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { info } = useTranslations(getLangFromUrl(Astro.url)).contactPage;
---

<section class="section info">
  <div class="wrap layout">
    <h2 class="h2">{info.title}</h2>
    <dl class="rows">
      {info.items.map(({ label, value, text }) => (
        <div class="row">
          <dt>{label}</dt>
          <dd>
            <strong>{value}</strong>
            <span>{text}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .info {
    padding-top: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: start;
    gap: 72px;
  }

  .h2 {
    max-width: 12ch;
  }

  .rows {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 8px 32px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }

  dt {
    color: var(--text-muted);
    font: 400 15px/24px var(--font-sans);
  }

  dd {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  strong {
    color: var(--text);
    font: 500 18px/26px var(--font-sans);
  }

  dd span {
    color: var(--text-body);
    font: 400 15px/24px var(--font-sans);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
