---
import Button from '@/components/ui/Button.astro';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { academy } = useTranslations(lang);
// Highest level on top and flush; each lower rung steps further in.
const last = academy.levels.length - 1;
const rungs = academy.levels.map((level, i) => ({ ...level, indent: last - i })).reverse();
---

<section class="section" id="akademija">
  <div class="wrap layout">
    <div class="intro reveal">
      <h2 class="h2">{academy.title}</h2>
      <p class="lead">{academy.lead}</p>
      <dl class="stats">
        {academy.stats.map(({ value, label }) => (
          <div class="reveal">
            <dt class="caption">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="btn-row">
        <Button href={getPageUrl(lang, 'academy')} icon="north-east">
          {academy.cta}
        </Button>
      </div>
    </div>

    <ol class="ladder" reversed>
      {rungs.map(({ level, title, meta, indent }) => (
        <li class="rung reveal" style={`--indent: ${indent}`}>
          <span class="level">{level}</span>
          <span class="title">{title}</span>
          <span class="caption">{meta}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: 64px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin: 16px 0 0;
  }

  .stats div {
    display: grid;
    gap: 2px;
  }

  /* Number above its label. */
  .stats dd {
    order: -1;
    margin: 0;
    font: 400 44px/52px var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .btn-row {
    margin-top: 12px;
  }

  .ladder {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rung {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    margin-left: calc(var(--indent) * 4.2%);
    padding: 16px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease),
      translate 0.35s var(--ease);
  }

  .rung:hover {
    border-color: var(--accent-border);
    translate: 4px 0;
  }

  .level {
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }

  .title {
    font: 400 19px/26px var(--font-sans);
    color: var(--text);
  }

  /* The top rung is inverted. */
  .rung:first-child {
    border-color: var(--text);
    background: var(--text);
  }

  .rung:first-child .title {
    color: var(--bg);
  }

  .rung:first-child .caption {
    color: var(--border);
  }

  .rung:first-child .level {
    color: var(--accent-hover);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats {
      gap: 28px;
    }

    .rung {
      grid-template-columns: 60px minmax(0, 1fr);
      gap: 4px 12px;
      margin-left: 0;
      padding: 14px 16px;
    }

    .rung .caption {
      grid-column: 2;
    }
  }
</style>
