---
import Button from '@/components/ui/Button.astro';
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const { connect, analyze, act } = t.steps.items;
const steps = [connect, analyze, act];
---

<section class="section-dark band-haze" id="kako-radi" data-theme="dark">
  <div class="head">
    <h2 class="h2 reveal-title">{t.steps.title}</h2>
    <Button class="reveal" href={links.signup} icon="north-east">
      {t.actions.start}
    </Button>
  </div>
  <ol class="steps">
    {steps.map((step, i) => (
      <li class="step reveal-left">
        <p class="number">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="h3">{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  #kako-radi::before {
    background: radial-gradient(45% 70% at 100% 0%, rgb(22 164 173 / 0.18), transparent 70%);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: 120px var(--gutter) 56px;
  }

  .head .h2 {
    max-width: 640px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A hairline that fades out at both ends, above the row of steps. */
  .steps::before {
    content: '';
    grid-column: 1 / -1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(66 202 215 / 0.18), transparent);
  }

  /* The steps cascade in from the left. */
  .step:nth-child(2) {
    animation-range: entry 8% cover 38%;
  }

  .step:nth-child(3) {
    animation-range: entry 16% cover 46%;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 32px var(--gutter) 64px;
    border-right: 1px solid var(--border);
    transition: background-color 0.3s var(--ease);
  }

  .step:last-child {
    border-right: 0;
  }

  .step:hover {
    background: var(--surface);
  }

  .number {
    margin: 0;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }

  .step p:last-child {
    margin: 0;
  }

  @media (max-width: 640px) {
    .head {
      padding: 64px 16px 40px;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      padding: 28px var(--gutter) 36px;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .step:last-child {
      border-bottom: 0;
    }
  }
</style>
