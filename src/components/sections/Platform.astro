---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import academyPhoto from '@/assets/photos/tools/academy.webp';
import alertsPhoto from '@/assets/photos/tools/alerts.webp';
import analysisPhoto from '@/assets/photos/tools/analysis.webp';
import botsPhoto from '@/assets/photos/tools/bots.webp';
import calendarPhoto from '@/assets/photos/tools/calendar.webp';
import journalPhoto from '@/assets/photos/tools/journal.webp';
import mentorPhoto from '@/assets/photos/tools/mentor.webp';
import planPhoto from '@/assets/photos/tools/plan.webp';
import propFirmPhoto from '@/assets/photos/tools/prop-firm.webp';
import scenariosPhoto from '@/assets/photos/tools/scenarios.webp';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import Statement from '@/components/ui/Statement.astro';
import { links } from '@/data/links';
import type { Dictionary } from '@/i18n/sr';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const { platform } = t;

const features: {
  id: keyof Dictionary['platform']['features'];
  icon: IconName;
  photo: ImageMetadata;
}[] = [
  { id: 'analysis', icon: 'insights', photo: analysisPhoto },
  { id: 'plan', icon: 'event-note', photo: planPhoto },
  { id: 'scenarios', icon: 'call-split', photo: scenariosPhoto },
  { id: 'journal', icon: 'menu-book', photo: journalPhoto },
  { id: 'mentor', icon: 'psychology', photo: mentorPhoto },
  { id: 'alerts', icon: 'notifications', photo: alertsPhoto },
  { id: 'calendar', icon: 'calendar-month', photo: calendarPhoto },
  { id: 'bots', icon: 'smart-toy', photo: botsPhoto },
  { id: 'propFirm', icon: 'verified-user', photo: propFirmPhoto },
  { id: 'academy', icon: 'school', photo: academyPhoto },
];
---

<section class="section" id="platforma">
  <div class="wrap">
    <Statement parts={platform.statement} class="statement" />

    <div class="carousel">
      <div class="controls reveal">
        <p class="caption">{platform.toolsCount}</p>
        <div class="arrows">
          <button class="arrow" type="button" aria-label={platform.prev} data-direction="-1">
            <Icon name="arrow-back" />
          </button>
          <button class="arrow" type="button" aria-label={platform.next} data-direction="1">
            <Icon name="arrow-forward" />
          </button>
        </div>
      </div>

      <ul class="rail">
        {features.map(({ id, icon, photo }) => {
          const feature = platform.features[id];
          return (
            <li class="card" data-theme="dark">
              <div class="photo">
                <Image src={photo} alt="" />
              </div>
              <div class="card-top">
                <span class="icon-circle">
                  <Icon name={icon} />
                </span>
                <span class="caption">{feature.tier}</span>
              </div>
              <div>
                <h3 class="h3">{feature.title}</h3>
                <p class="body-sm">{feature.text}</p>
                <Button href={links.dashboard} variant="ghost" size="sm" icon="north-east">
                  {t.actions.more}
                </Button>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>('#platforma .rail');
  document.querySelectorAll<HTMLButtonElement>('#platforma .arrow').forEach((button) =>
    button.addEventListener('click', () => {
      const card = rail?.firstElementChild as HTMLElement | null;
      const step = (card?.offsetWidth ?? 300) + 16;
      rail?.scrollBy({ left: Number(button.dataset.direction) * step, behavior: 'smooth' });
    }),
  );
</script>

<style>
  .statement {
    margin-top: 20px;
  }

  .carousel {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: end;
    gap: 32px;
    margin-top: 72px;
  }

  .controls {
    display: grid;
    gap: 16px;
    padding-bottom: 8px;
  }

  .arrows {
    display: flex;
    gap: 8px;
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  .arrow:hover {
    background: var(--surface-hover);
  }

  .rail {
    display: flex;
    gap: 16px;
    margin: 0 calc(-1 * var(--gutter)) 0 0;
    padding: 0 var(--gutter) 4px 0;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .card {
    position: relative;
    display: flex;
    flex: 0 0 300px;
    flex-direction: column;
    justify-content: space-between;
    height: 420px;
    padding: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--bg);
    scroll-snap-align: start;
    transition: border-color 0.25s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  /* Every third card is teal, the one after it a lifted ink. */
  .card:nth-child(3n + 1) {
    border-color: var(--teal-line);
    background: var(--teal-grad);
  }

  .card:nth-child(3n + 1):hover {
    border-color: rgb(66 202 215 / 0.5);
  }

  .card:nth-child(3n + 3) {
    background: linear-gradient(180deg, var(--surface), var(--bg));
  }

  .card > * {
    position: relative;
    z-index: 1;
  }

  /* The photo fills the top and fades into the card. */
  .card > .photo {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    height: 64%;
    mask-image: linear-gradient(180deg, #000 40%, transparent 100%);
  }

  .photo img {
    opacity: 0.85;
    transition:
      transform 1s var(--ease),
      opacity 0.4s var(--ease);
  }

  .card:hover .photo img {
    opacity: 1;
    transform: scale(1.05);
  }

  /* The rail scrolls sideways, so the cards follow the carousel's own pass through the viewport. */
  @supports (animation-timeline: view()) {
    .carousel {
      view-timeline: --carousel block;
    }

    .card,
    .photo img {
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --carousel;
    }

    .card {
      animation-name: up-in;
      animation-range: entry 10% cover 40%;
    }

    .card:nth-child(2) {
      animation-range: entry 14% cover 44%;
    }

    .card:nth-child(3) {
      animation-range: entry 18% cover 48%;
    }

    .card:nth-child(4) {
      animation-range: entry 22% cover 52%;
    }

    .card:nth-child(n + 5) {
      animation-range: entry 26% cover 56%;
    }

    .photo img {
      animation-name: photo-drift;
      animation-range: cover 0% cover 100%;
    }
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card .body-sm {
    margin: 8px 0 16px;
  }

  @media (max-width: 1080px) {
    .carousel {
      grid-template-columns: minmax(0, 1fr);
    }

    .controls {
      grid-auto-flow: column;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .rail {
      margin-right: -16px;
      padding-right: 16px;
    }

    .card {
      flex-basis: 260px;
      height: 380px;
    }
  }
</style>
