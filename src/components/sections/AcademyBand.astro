---
// The Academy as a staircase of six levels, on the page's one light band.
import Button from '@/components/ui/Button.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels, levelPlan } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { level: count } = t.academyPage;
const levels = await getLevels();
---

<section class="section academy" id="akademija" data-theme="mist">
  <div class="wrap">
    <div class="intro-center">
      <h2 class="h2 reveal-title">{t.academyBand.title}</h2>
      <p class="lead reveal">{t.academyBand.lead}</p>
    </div>

    <ol class="stairs">
      {levels.map(({ order, id, title, subtitle, modules, lessonCount }, i) => (
        <li class="step reveal" style={`--rise: ${i}`}>
          <a href={getPageUrl(lang, 'academy', id)}>
            <span class="number">{order}</span>
            <span class="h4">{title[lang]}</span>
            <span class="subtitle">{subtitle[lang]}</span>
            <span class="count">
              {count.modules(modules.length)}, {count.lessons(lessonCount)}
            </span>
            {levelPlan(order) === 'free' && <span class="free">{t.academyBand.free}</span>}
          </a>
        </li>
      ))}
    </ol>

    <div class="foot">
      <p>{t.academyBand.note}</p>
      <Button href={links.signup}>{t.academyBand.cta}</Button>
    </div>
  </div>
</section>

<style>
  .academy {
    background: var(--bg);
    color: var(--text-body);
  }

  .stairs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  /* Each level stands a step higher than the one before it. */
  .step a {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    height: calc(230px + var(--rise) * 40px);
    padding: 18px;
    border-top: 4px solid var(--accent-text);
    border-right: 1px solid var(--border);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .step a:hover {
    background: var(--surface-hover);
  }

  .number {
    color: var(--accent-text);
    font: 700 44px/1 var(--font-display);
    letter-spacing: -0.04em;
  }

  .h4 {
    margin-top: 8px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 20px;
  }

  .count {
    margin-top: 10px;
    color: var(--text-muted);
    font: 500 12px/16px var(--font-mono);
  }

  .free {
    align-self: flex-start;
    margin-top: 10px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-subtle);
    color: var(--accent-text);
    font-size: 12px;
    font-weight: 600;
    line-height: 18px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    max-width: 1180px;
    margin: 48px auto 0;
  }

  .foot p {
    max-width: 60ch;
    margin: 0;
  }

  @media (max-width: 1080px) {
    .stairs {
      grid-template-columns: minmax(0, 1fr);
    }

    .step a {
      height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
