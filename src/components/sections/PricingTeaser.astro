---
// The home page's short version of the plans: one row per plan with its monthly price.
// The full cards, billing toggle and comparison live on the plans page.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { formatPrice, prices } from '@/data/pricing';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { pricing } = useTranslations(lang);
const plansUrl = getPageUrl(lang, 'plans');
const plans = [
  { ...pricing.plans.free, price: formatPrice(0, lang), per: pricing.forever, featured: false },
  {
    ...pricing.plans.starter,
    price: formatPrice(prices[lang].starter, lang),
    per: pricing.perMonth,
    featured: false,
  },
  {
    ...pricing.plans.premium,
    price: formatPrice(prices[lang].premium, lang),
    per: pricing.perMonth,
    featured: true,
  },
];
---

<section class="section pricing-teaser" id="paketi">
  <div class="wrap layout">
    <div class="intro reveal">
      <h2 class="h2">{pricing.title}</h2>
      <p class="lead">{pricing.teaserLead}</p>
      <div class="btn-row">
        <Button href={plansUrl} icon="north-east">
          {pricing.compare}
        </Button>
      </div>
      <p class="caption guarantee">
        <Icon name="verified-user" size={16} />
        {pricing.guarantee}
      </p>
    </div>

    <ul class="rows">
      {plans.map(({ name, description, price, per, featured }) => (
        <li class="reveal">
          <a class="row" href={plansUrl} data-theme={featured ? 'dark' : undefined}>
            <span class="name">
              <strong>{name}</strong>
              <span class="caption">{description}</span>
            </span>
            <span class="price">
              <strong>{price}</strong>
              <span class="caption">{per}</span>
            </span>
            <Icon name="north-east" class="arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing-teaser {
    padding-top: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: 64px;
  }

  .btn-row {
    margin-top: 8px;
  }

  .guarantee {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 14px;
  }

  .guarantee :global(svg) {
    color: var(--accent-text);
  }

  .rows {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 32px;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease),
      translate 0.35s var(--ease);
  }

  .row:hover {
    border-color: var(--border-strong);
    translate: 4px 0;
  }

  .row[data-theme='dark'] {
    background: var(--bg);
  }

  .name,
  .price {
    display: grid;
    gap: 2px;
  }

  .name strong {
    font: 400 22px/28px var(--font-sans);
    color: var(--text);
  }

  .price {
    text-align: right;
  }

  .price strong {
    font: 400 25px/30px var(--font-sans);
    color: var(--text);
  }

  .arrow {
    color: var(--text-muted);
    transition:
      transform 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .row:hover .arrow {
    transform: translate(2px, -2px);
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      padding: 20px;
    }

    .arrow {
      display: none;
    }
  }
</style>
