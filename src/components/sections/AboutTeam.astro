---
// The team in a ruled row, and an invitation for people who share the principles.
import Icon from '@/components/ui/Icon.astro';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { team } = useTranslations(lang).aboutPage;
---

<section class="section team" id="tim">
  <div class="wrap">
    <div class="intro head">
      <h2 class="h2">{team.title}</h2>
      <p class="lead">{team.lead}</p>
    </div>

    <ul class="members">
      {team.members.map(({ initials, name, role, text }) => (
        <li class="member">
          <span class="avatar" aria-hidden="true">
            {initials}
          </span>
          <div>
            <h3 class="name">{name}</h3>
            <p class="role">{role}</p>
          </div>
          <p class="body-sm">{text}</p>
        </li>
      ))}
    </ul>

    <a class="join" href={getPageUrl(lang, 'contact')}>
      <Icon name="groups" size={24} />
      <span>
        <strong>{team.join.title}.</strong> {team.join.text}.
      </span>
      <span class="join-cta">
        {team.join.cta}
        <Icon name="north-east" size={16} />
      </span>
    </a>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
    margin-bottom: 56px;
  }

  .members {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .member {
    display: grid;
    align-content: start;
    gap: 18px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--teal-grad);
    color: var(--text);
    font: 700 24px/1 var(--font-display);
  }

  .name {
    margin: 0 0 2px;
    color: var(--text);
    font: 500 18px/26px var(--font-sans);
  }

  .role {
    margin: 0;
    color: var(--text-muted);
    font: 400 14px/20px var(--font-sans);
  }

  .join {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 56px;
    padding: 24px 0;
    border-block: 1px solid var(--border);
    color: var(--text-body);
    text-decoration: none;
  }

  .join > :global(svg) {
    color: var(--accent-text);
  }

  .join strong {
    color: var(--text);
    font-weight: 500;
  }

  .join-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    color: var(--accent-text);
    font: 500 15px/22px var(--font-sans);
  }

  .join-cta :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .join:hover .join-cta :global(svg) {
    transform: translate(2px, -2px);
  }

  .join:hover strong {
    color: var(--accent-hover);
  }

  @media (max-width: 860px) {
    .members {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .join-cta {
      margin-left: 0;
    }
  }
</style>
