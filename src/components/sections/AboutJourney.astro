---
// Milestones on a line: pick one to read about it; the line fills up to it. A radio group,
// no script; one rule per milestone shows its card.
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { journey } = useTranslations(getLangFromUrl(Astro.url)).aboutPage;
const icons: IconName[] = ['flag', 'school', 'insights', 'rocket-launch'];
// The platform launch, the latest milestone reached.
const current = 2;
---

<section class="section" id="put">
  <div class="wrap">
    <div class="intro head reveal">
      <h2 class="h2 reveal-title">{journey.title}</h2>
      <p class="lead">{journey.lead}</p>
    </div>

    <div class="journey">
      <fieldset class="points">
        <legend class="sr-only">{journey.title}</legend>
        {journey.items.map(({ year, title }, i) => (
          <>
            <input
              class="sr-only"
              type="radio"
              name="milestone"
              id={`milestone-${i}`}
              checked={i === current}
            />
            <label class="point reveal-pop" for={`milestone-${i}`}>
              <span class="dot">
                <Icon name={icons[i]} />
              </span>
              <span class="year">{year}</span>
              <span class="title">{title}</span>
            </label>
          </>
        ))}
      </fieldset>

      {journey.items.map(({ year, title, text }, i) => (
        <div class={`card card-${i}`}>
          <p class="year">{year}</p>
          <h3 class="h3">{title}</h3>
          <p class="lead">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  .head {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .journey {
    display: grid;
    gap: 32px;
  }

  .points {
    /* Anchors the visually hidden radios, so focusing one doesn't scroll the page. */
    position: relative;
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .point {
    --dot: 56px;

    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 0 8px;
    color: var(--text-muted);
    text-align: center;
    cursor: pointer;
  }

  .point:nth-of-type(2) {
    animation-range: entry 9% cover 39%;
  }

  .point:nth-of-type(3) {
    animation-range: entry 13% cover 43%;
  }

  .point:nth-of-type(4) {
    animation-range: entry 17% cover 47%;
  }

  /* The stretch of line leading to each milestone, between its dot and the previous one. */
  .point:not(:first-of-type)::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 1px);
    right: calc(50% + var(--dot) / 2);
    left: calc(-50% + var(--dot) / 2);
    height: 2px;
    background: rgb(66 202 215 / 0.14);
    transition: background-color 0.7s var(--ease);
  }

  .dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border: 1px solid rgb(66 202 215 / 0.22);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-muted);
    transition: all 0.4s var(--ease);
  }

  .point:hover .dot {
    border-color: var(--accent);
  }

  .year {
    margin: 6px 0 0;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .title {
    color: var(--text-body);
    font: 400 16px/22px var(--font-sans);
    transition: color 0.3s var(--ease);
  }

  /* Reached: every milestone up to the checked one. */
  .point:has(~ input:checked)::before,
  input:checked + .point::before {
    background: var(--accent);
  }

  .point:has(~ input:checked) .dot,
  input:checked + .point .dot {
    border-color: rgb(66 202 215 / 0.5);
    color: var(--accent);
  }

  input:checked + .point .dot {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    scale: 1.08;
  }

  input:checked + .point .title {
    color: var(--text);
  }

  input:focus-visible + .point .dot {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .card {
    display: none;
    justify-items: center;
    gap: 12px;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 36px 40px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: rgb(12 21 32 / 0.6);
    text-align: center;
  }

  .journey:has(#milestone-0:checked) .card-0,
  .journey:has(#milestone-1:checked) .card-1,
  .journey:has(#milestone-2:checked) .card-2,
  .journey:has(#milestone-3:checked) .card-3 {
    display: grid;
    animation: card-in 0.6s var(--ease-out) both;
  }

  .card .year {
    margin: 0;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card .lead {
    text-align: center;
  }

  @media (max-width: 640px) {
    .point {
      --dot: 44px;
    }

    .title {
      font-size: 13px;
      line-height: 18px;
    }

    .card {
      padding: 24px 20px;
    }
  }
</style>
