---
// The milestones on one line, every one in view. The day line runs solid up to the latest
// milestone reached and dashed on to what comes next.
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { journey } = useTranslations(getLangFromUrl(Astro.url)).aboutPage;
// The platform launch, the latest milestone reached.
const current = 2;
---

<section class="section" id="put">
  <div class="wrap">
    <div class="intro head">
      <h2 class="h2">{journey.title}</h2>
      <p class="lead">{journey.lead}</p>
    </div>

    <ol class="line" style={`--reached: ${current / journey.items.length}`}>
      {journey.items.map(({ year, title, text }, i) => (
        <li class:list={['milestone', { reached: i <= current, current: i === current }]}>
          <span class="node" aria-hidden="true"></span>
          <p class="year">{year}</p>
          <h3 class="title">{title}</h3>
          <p class="text">{text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 640px;
    margin-bottom: 64px;
  }

  .line {
    --node: 14px;
    --gap: 40px;

    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The track ahead, dashed, and the day line over the stretch already travelled. */
  .line::before,
  .line::after {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    left: 0;
    height: 2px;
  }

  .line::before {
    right: 0;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 12px);
  }

  .line::after {
    /* Up to the latest node: each column plus its gap is a quarter of (width + gap). */
    width: calc(var(--reached) * (100% + var(--gap)) + var(--node));
    background: linear-gradient(90deg, var(--price), var(--accent));
  }

  .milestone {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .node {
    position: relative;
    z-index: 1;
    width: var(--node);
    height: var(--node);
    margin-bottom: 18px;
    border: 2px solid var(--border-strong);
    border-radius: 50%;
    background: var(--page);
  }

  .reached .node {
    border-color: var(--accent);
  }

  .milestone:first-child .node {
    border-color: var(--price);
  }

  .current .node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 6px rgb(66 202 215 / 0.16);
  }

  .year {
    margin: 0;
    color: var(--text-muted);
    font: 500 15px/20px var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .title {
    margin: 0;
    color: var(--text);
    font: 700 24px/30px var(--font-display);
    letter-spacing: -0.02em;
  }

  .text {
    max-width: 34ch;
    margin: 0;
    font-size: 15px;
    line-height: 24px;
  }

  @media (max-width: 860px) {
    .line {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-left: 36px;
    }

    .line::before,
    .line::after {
      top: 4px;
      left: calc(var(--node) / 2 - 1px);
      width: 2px;
      height: auto;
    }

    .line::before {
      bottom: 0;
      background: repeating-linear-gradient(
        180deg,
        var(--border-strong) 0 6px,
        transparent 6px 12px
      );
    }

    .line::after {
      height: calc(var(--reached) * 100%);
      background: var(--day-line);
    }

    .node {
      position: absolute;
      top: 3px;
      left: -36px;
      margin: 0;
    }
  }

  @media (max-width: 640px) {
    .head {
      margin-bottom: 40px;
    }
  }
</style>
