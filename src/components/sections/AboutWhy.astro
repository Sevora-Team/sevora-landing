---
// Why SEVORA exists: the heading beside the three paragraphs that answer it. The risk chart the
// last paragraph points to sits in the page hero.
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { why } = useTranslations(getLangFromUrl(Astro.url)).aboutPage;
---

<section class="section" id="zasto">
  <div class="wrap layout">
    <h2 class="h2">{why.title}</h2>
    <div class="story">
      {why.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: 72px;
  }

  .h2 {
    max-width: 14ch;
  }

  .story {
    display: grid;
    gap: 20px;
  }

  p {
    max-width: 60ch;
    margin: 0;
    font-size: 18px;
    line-height: 29px;
  }

  p:last-child {
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    p {
      font-size: 17px;
      line-height: 27px;
    }
  }
</style>
