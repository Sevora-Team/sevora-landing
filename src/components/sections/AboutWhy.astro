---
// Why SEVORA exists, beside a chart that replays the same trades at three risk levels.
// The risk switch is a radio group, no script: the checked level picks the curve and figures.
import Icon from '@/components/ui/Icon.astro';
import { numberLocales } from '@/i18n/locales';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { formatChange } from '@/lib/format';
import { RISK_BASELINE, RISK_HEIGHT, RISK_LEVELS, RISK_WIDTH, riskCurve } from '@/lib/risk';

const lang = getLangFromUrl(Astro.url);
const { why } = useTranslations(lang).aboutPage;
const { chart } = why;
const locale = numberLocales[lang];
const curves = RISK_LEVELS.map(riskCurve);
---

<section class="section" id="zasto">
  <div class="wrap layout">
    <div class="story">
      <p class="kicker reveal-left">{why.kicker}</p>
      <h2 class="h2 reveal-left">{why.title}</h2>
      {why.paragraphs.map((paragraph) => (
        <p class="paragraph reveal-left">{paragraph}</p>
      ))}
    </div>

    <figure class="chart reveal-right">
      <div class="top">
        <div>
          <p class="chart-title">{chart.title}</p>
          <p class="caption">{chart.subtitle}</p>
        </div>
        <fieldset class="risks">
          <legend class="sr-only">{chart.riskLabel}</legend>
          {curves.map(({ risk }, i) => (
            <>
              <input class="sr-only" type="radio" name="risk" id={`risk-${i}`} checked={i === 0} />
              <label for={`risk-${i}`}>{risk}%</label>
            </>
          ))}
        </fieldset>
      </div>

      <svg
        class="plot"
        viewBox={`0 0 ${RISK_WIDTH} ${RISK_HEIGHT}`}
        preserveAspectRatio="none"
        role="img"
        aria-label={chart.label}
      >
        <defs>
          <linearGradient id="risk-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-opacity="0.28"></stop>
            <stop offset="1" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <line class="baseline" x1="0" x2={RISK_WIDTH} y1={RISK_BASELINE} y2={RISK_BASELINE} />
        {curves.map(({ line, area }, i) => (
          <>
            <path class={`area curve-${i}`} d={area} fill="url(#risk-fill)" />
            <path class={`line curve-${i}`} d={line} pathLength="1" />
          </>
        ))}
      </svg>
      <div class="axis caption" aria-hidden="true">
        <span>{chart.start}</span>
        <span>{chart.end}</span>
      </div>

      <dl class="figures">
        <div>
          <dt class="caption">{chart.risk}</dt>
          <dd>
            {curves.map(({ risk }, i) => (
              <span class={`curve-${i}`}>{risk}%</span>
            ))}
          </dd>
        </div>
        <div>
          <dt class="caption">{chart.change}</dt>
          <dd>
            {curves.map(({ change }, i) => (
              <span class:list={[`curve-${i}`, change >= 0 ? 'up' : 'down']}>
                {formatChange(change, locale, 1)}
              </span>
            ))}
          </dd>
        </div>
        <div>
          <dt class="caption">{chart.drawdown}</dt>
          <dd>
            {curves.map(({ drawdown }, i) => (
              <span class={`curve-${i} down`}>{formatChange(-drawdown, locale, 1)}</span>
            ))}
          </dd>
        </div>
      </dl>
      <figcaption class="caption note">
        <Icon name="info" size={16} />
        {chart.note}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: 72px;
  }

  .story {
    display: grid;
    gap: 20px;
  }

  .kicker {
    margin: 0;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .paragraph {
    max-width: 52ch;
    margin: 0;
  }

  .paragraph:last-child {
    color: var(--text);
  }

  .chart {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 28px;
    border: 1px solid rgb(66 202 215 / 0.18);
    border-radius: var(--radius-card);
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(22 164 173 / 0.14), transparent 70%),
      rgb(12 21 32 / 0.72);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .chart-title {
    margin: 0 0 4px;
    color: var(--text);
    font: 500 17px/24px var(--font-sans);
  }

  /* Segmented control, like the billing toggle. */
  .risks {
    position: relative;
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }

  .risks label {
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font: 500 14px/20px var(--font-sans);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .risks label:hover {
    color: var(--text);
  }

  .risks input:checked + label {
    background: var(--accent);
    color: var(--on-accent);
  }

  .risks input:focus-visible + label {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .plot {
    width: 100%;
    height: 240px;
    overflow: visible;
  }

  stop {
    stop-color: var(--accent);
  }

  .baseline {
    stroke: rgb(240 240 240 / 0.18);
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }

  .line {
    fill: none;
    stroke: rgb(169 180 191 / 0.22);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.4s var(--ease),
      stroke-width 0.4s var(--ease);
  }

  .area {
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  .figures span {
    display: none;
  }

  /* The checked risk level: its curve draws in, its figures show. One rule per level. */
  .chart:has(#risk-0:checked) .line.curve-0,
  .chart:has(#risk-1:checked) .line.curve-1,
  .chart:has(#risk-2:checked) .line.curve-2 {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-dasharray: 1;
    animation: draw 1.2s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .chart:has(#risk-0:checked) .area.curve-0,
  .chart:has(#risk-1:checked) .area.curve-1,
  .chart:has(#risk-2:checked) .area.curve-2 {
    opacity: 1;
  }

  .chart:has(#risk-0:checked) .figures .curve-0,
  .chart:has(#risk-1:checked) .figures .curve-1,
  .chart:has(#risk-2:checked) .figures .curve-2 {
    display: inline;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: -8px;
    font-family: var(--font-mono);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }

  .figures div {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.03);
  }

  dd {
    margin: 0;
    color: var(--text);
    font: 400 26px/32px var(--font-sans);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .up {
    color: var(--up);
  }

  .down {
    color: var(--down);
  }

  .note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .note svg {
    flex: none;
    color: var(--accent);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .chart {
      padding: 18px;
    }

    .plot {
      height: 180px;
    }

    .figures div {
      padding: 10px 12px;
    }

    dd {
      font-size: 19px;
      line-height: 26px;
    }
  }
</style>
