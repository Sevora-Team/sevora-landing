---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { links } from '@/data/links';
import { formatPrice, planPrice, prices } from '@/data/pricing';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { comparison } = t.plansPage;
const { pricing } = t;
const plans = [
  { name: pricing.plans.free.name, price: undefined },
  { name: pricing.plans.starter.name, price: planPrice(prices[lang].starter, lang) },
  { name: pricing.plans.premium.name, price: planPrice(prices[lang].premium, lang) },
];
const last = plans.length - 1;
const trustIcons: IconName[] = ['verified-user', 'event-repeat', 'credit-card'];
---

<section class="section comparison" id="poredjenje">
  <div class="wrap">
    <div class="intro reveal">
      <h2 class="h2 reveal-title">{comparison.title}</h2>
      <p class="lead">{comparison.lead}</p>
    </div>

    <div class="table-scroll">
      <table>
        <caption class="caption">{comparison.note}</caption>
        <thead>
          <tr>
            <th scope="col" class="caption">
              {comparison.feature}
            </th>
            {plans.map(({ name, price }, i) => (
              <th scope="col" class:list={{ pro: i === last }}>
                <div class="plan">
                  <strong>{name}</strong>
                  {price ? (
                    <>
                      <span class="caption when-monthly">
                        {price.monthly} {pricing.perMonth}
                      </span>
                      <span class="caption when-yearly">
                        {price.yearly} {pricing.perMonth}
                      </span>
                    </>
                  ) : (
                    <span class="caption">
                      {formatPrice(0, lang)} {pricing.forever}
                    </span>
                  )}
                  <Button href={links.signup} size="sm" variant={i === last ? 'primary' : 'ghost'}>
                    {comparison.choose[i]}
                  </Button>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        {comparison.groups.map(({ title, rows }) => (
          <tbody>
            <tr class="group">
              <th scope="colgroup" class="mono-label">
                {title}
              </th>
              {plans.map((_, i) => (
                <td class:list={{ pro: i === last }} />
              ))}
            </tr>
            {rows.map(({ feature, cells }) => (
              <tr>
                <th scope="row">{feature}</th>
                {cells.map((cell, i) => (
                  <td class:list={{ pro: i === last }}>
                    {cell === true ? (
                      <Icon name="check" class="yes" label={comparison.included} />
                    ) : cell === false ? (
                      <span class="no">
                        <span aria-hidden="true">—</span>
                        <span class="sr-only">{comparison.notIncluded}</span>
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>

    <ul class="trust">
      {comparison.trust.map(({ title, text }, i) => (
        <li class="reveal">
          <span class="icon-circle icon-circle-accent">
            <Icon name={trustIcons[i]} />
          </span>
          <div>
            <strong>{title}</strong>
            <p class="body-sm">{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    max-width: 640px;
    margin-bottom: 48px;
  }

  /* Contains the visually hidden labels, so they scroll with the table instead of widening the page. */
  .table-scroll {
    position: relative;
  }

  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font: 400 15px/22px var(--font-sans);
  }

  caption {
    caption-side: bottom;
    padding-top: 16px;
    text-align: left;
  }

  th,
  td {
    text-align: left;
  }

  /* Plan names, prices and buttons stay in view while the rows scroll by. */
  thead th {
    position: sticky;
    top: var(--header-height);
    z-index: 5;
    padding: 20px 20px 18px;
    border-bottom: 1px solid var(--border-strong);
    background: var(--page);
    vertical-align: bottom;
  }

  thead th.pro {
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    /* Opaque, so rows don't show through the sticky header. */
    background: linear-gradient(rgb(66 202 215 / 0.06), rgb(66 202 215 / 0.06)), var(--page);
  }

  thead th:first-child,
  tbody th {
    width: 34%;
    padding-left: 0;
  }

  .plan {
    display: grid;
    justify-items: start;
    gap: 2px;
  }

  .plan strong {
    font: 400 22px/28px var(--font-sans);
    color: var(--text);
  }

  .plan :global(.btn) {
    margin-top: 12px;
  }

  .group > * {
    padding: 44px 20px 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .group th {
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  tbody tr:not(.group) > * {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--text-body);
    vertical-align: middle;
    transition: background-color 0.2s var(--ease);
  }

  tbody tr:not(.group) > th {
    padding-left: 0;
    color: var(--text);
    font-weight: 400;
  }

  tbody tr:not(.group):hover > * {
    background: var(--surface-hover);
  }

  .pro {
    background: rgb(66 202 215 / 0.06);
  }

  tbody:last-of-type tr:last-child .pro {
    border-bottom-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
  }

  .yes {
    color: var(--accent-text);
  }

  .no {
    color: var(--text-disabled);
  }

  .trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .trust li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--teal-line-soft);
    border-radius: var(--radius-card);
    background: var(--teal-glass);
  }

  .trust strong {
    display: block;
    margin-bottom: 4px;
    color: var(--text);
    font: 500 16px/24px var(--font-sans);
  }

  @media (max-width: 1080px) {
    .table-scroll {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
    }

    table {
      min-width: 760px;
    }

    thead th {
      position: static;
    }

    .trust {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .table-scroll {
      margin-inline: -16px;
      padding-inline: 16px;
    }
  }
</style>
