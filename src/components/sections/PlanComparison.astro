---
import Icon from '@/components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const { comparison } = t.plansPage;
const plans = [t.pricing.plans.free, t.pricing.plans.starter, t.pricing.plans.premium];
---

<section class="section comparison" id="poredjenje">
  <div class="wrap">
    <div class="intro">
      <h2 class="h2 reveal">{comparison.title}</h2>
      <p class="lead reveal">{comparison.lead}</p>
    </div>

    <div class="table-scroll reveal">
      <table>
        <thead>
          <tr>
            <th scope="col" class="mono-label">
              {comparison.feature}
            </th>
            {plans.map(({ name }, i) => (
              <th scope="col" class:list={{ featured: i === plans.length - 1 }}>
                {name}
              </th>
            ))}
          </tr>
        </thead>
        {comparison.groups.map(({ title, rows }) => (
          <tbody>
            <tr class="group">
              <th scope="colgroup" colspan={plans.length + 1} class="mono-label">
                <span>{title}</span>
              </th>
            </tr>
            {rows.map(({ feature, cells }) => (
              <tr>
                <th scope="row">{feature}</th>
                {cells.map((cell, i) => (
                  <td class:list={{ featured: i === plans.length - 1 }}>
                    {cell === true ? (
                      <Icon name="check" class="yes" label={comparison.included} />
                    ) : cell === false ? (
                      <span class="no">
                        <span aria-hidden="true">—</span>
                        <span class="sr-only">{comparison.notIncluded}</span>
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>
</section>

<style>
  .comparison {
    padding-top: 0;
  }

  /* Wide table scrolls sideways on small screens, with the feature column pinned. */
  .table-scroll {
    margin-top: 48px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font: 400 15px/22px var(--font-sans);
  }

  th,
  td {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  tbody:last-child tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    color: var(--text);
    font: 500 17px/24px var(--font-sans);
    background: var(--surface);
  }

  thead th:first-child {
    position: sticky;
    left: 0;
    vertical-align: bottom;
    font: 500 12px/16px var(--font-mono);
    color: var(--text-muted);
  }

  tbody th[scope='row'] {
    position: sticky;
    left: 0;
    width: 28%;
    color: var(--text);
    font-weight: 400;
    background: var(--surface);
  }

  .group th {
    padding-top: 24px;
    padding-bottom: 10px;
    color: var(--accent-text);
    background: var(--surface);
  }

  /* The group cell spans the whole table; its label stays in view when it scrolls sideways. */
  .group span {
    position: sticky;
    left: 20px;
  }

  td {
    width: 24%;
    color: var(--text-body);
  }

  .featured,
  thead .featured {
    background: var(--surface-hover);
  }

  .yes {
    color: var(--accent-text);
  }

  .no {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .table-scroll {
      margin-top: 32px;
    }

    table {
      min-width: 600px;
    }

    th,
    td {
      padding: 12px 14px;
    }

    tbody th[scope='row'] {
      width: 140px;
    }
  }
</style>
