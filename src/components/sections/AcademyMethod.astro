---
// How a module works, as the three steps it takes, beside one real module from the curriculum
// shown in progress (sample state). The fourth point, the two languages, closes the steps.
import Icon from '@/components/ui/Icon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { learn } = t.academyPage;
const [lessons, check, badges, languages] = learn.items;

// Module 8, Candlestick patterns: three lessons done, the fourth next.
const DONE = 3;
const module = (await getLevels()).flatMap(({ modules }) => modules).find((m) => m.number === 8);
---

<section class="section method">
  <div class="wrap layout">
    <div class="story">
      <h2 class="h2">{learn.title}</h2>
      <ol class="steps">
        {[lessons, check, badges].map(({ title, text }) => (
          <li>
            <h3 class="h4">{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
      <p class="languages">
        <Icon name="translate" size={20} />
        <span>
          <strong>{languages.title}.</strong> {languages.text}
        </span>
      </p>
    </div>

    {module && (
      <figure class="module">
        <div class="panel" role="img" aria-label={learn.demo.label}>
          <div class="panel-head">
            <span class="module-n">{module.number}</span>
            <span>
              <strong>{module.title[lang]}</strong>
              <span class="caption">{learn.demo.progress(DONE, module.lessons.length)}</span>
            </span>
          </div>
          <div class="meter" aria-hidden="true">
            <span style={`--p: ${DONE / module.lessons.length}`}></span>
          </div>
          <ol class="lessons">
            {module.lessons.map(({ number, title }, i) => (
              <li class:list={{ done: i < DONE, current: i === DONE }}>
                <span class="state">
                  {i < DONE ? (
                    <Icon name="check" size={16} />
                  ) : (
                    <span class="lesson-n">{number}</span>
                  )}
                </span>
                <span class="lesson-title">{title[lang]}</span>
                {i === DONE && <span class="tag">{learn.demo.current}</span>}
              </li>
            ))}
          </ol>
          <div class="milestone">
            <Icon name="quiz" size={20} />
            <span>
              <span class="caption">{learn.demo.check}</span>
              {module.milestone[lang]}
            </span>
          </div>
          <div class="milestone">
            <Icon name="workspace-premium" size={20} class="medal" />
            <span>
              <span class="caption">{learn.demo.badge}</span>
              {module.badge[lang]}
            </span>
          </div>
        </div>
        <figcaption class="caption">{t.sample}</figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 80px;
  }

  .story {
    display: grid;
    gap: 36px;
  }

  /* A real sequence: lesson, check, badge. The counter is the order you go through them. */
  .steps {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 4px 0;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    color: var(--accent-text);
    font: 700 28px/1 var(--font-display);
  }

  .steps h3 {
    font-size: 19px;
    line-height: 26px;
  }

  .steps p {
    max-width: 44ch;
    margin: 0;
  }

  .languages {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .languages :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--accent-text);
  }

  .languages strong {
    color: var(--text);
    font-weight: 500;
  }

  .module {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .panel {
    display: grid;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-card);
    background: var(--teal-glass);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .panel-head > span:last-child {
    display: grid;
  }

  .module-n {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    background: var(--accent-subtle);
    color: var(--accent-text);
    font: 700 22px/1 var(--font-display);
  }

  .panel-head strong {
    color: var(--text);
    font: 500 18px/26px var(--font-sans);
  }

  .meter {
    height: 4px;
    border-radius: 4px;
    background: var(--border);
  }

  .meter span {
    display: block;
    width: calc(var(--p) * 100%);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--price), var(--accent));
  }

  .lessons {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lessons li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 15px;
    line-height: 22px;
  }

  .state {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    font: 400 11px/1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .done {
    color: var(--text-body);
  }

  .done .state {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .current {
    color: var(--text);
  }

  .current .state {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .lesson-title {
    flex: 1;
  }

  .tag {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--accent-subtle);
    color: var(--accent-text);
    font: 500 12px/18px var(--font-sans);
  }

  .milestone {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text);
    font-size: 15px;
    line-height: 22px;
  }

  .milestone > span {
    display: grid;
  }

  .milestone :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent-text);
  }

  .milestone :global(.medal) {
    color: var(--price);
  }

  figcaption {
    justify-self: end;
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
  }

  @media (max-width: 640px) {
    .panel {
      padding: 20px;
    }
  }
</style>
