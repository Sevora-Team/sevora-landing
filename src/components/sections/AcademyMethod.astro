---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { learn } = useTranslations(getLangFromUrl(Astro.url)).academyPage;
const icons: IconName[] = ['menu-book', 'quiz', 'workspace-premium', 'translate'];
---

<section class="section method">
  <div class="wrap">
    <h2 class="h2 reveal">{learn.title}</h2>
    <ul class="items">
      {learn.items.map(({ title, text }, i) => (
        <li class="item reveal">
          <span class="icon-circle">
            <Icon name={icons[i]} />
          </span>
          <h3 class="h4">{title}</h3>
          <p class="body-sm">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .method {
    padding-top: 0;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease),
      translate 0.35s var(--ease);
  }

  .item:hover {
    border-color: var(--border-strong);
    translate: 0 -3px;
  }

  .icon-circle {
    background: var(--accent-subtle);
    color: var(--accent-text);
  }

  h3 {
    font-size: 19px;
    font-weight: 400;
    line-height: 26px;
  }

  @media (max-width: 1080px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .items {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 32px;
    }
  }
</style>
