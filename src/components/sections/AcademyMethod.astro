---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import badgesPhoto from '@/assets/photos/academy/badges.webp';
import checksPhoto from '@/assets/photos/academy/checks.webp';
import languagesPhoto from '@/assets/photos/academy/languages.webp';
import lessonsPhoto from '@/assets/photos/academy/lessons.webp';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { learn } = useTranslations(getLangFromUrl(Astro.url)).academyPage;
const visuals: { icon: IconName; photo: ImageMetadata }[] = [
  { icon: 'menu-book', photo: lessonsPhoto },
  { icon: 'quiz', photo: checksPhoto },
  { icon: 'workspace-premium', photo: badgesPhoto },
  { icon: 'translate', photo: languagesPhoto },
];
---

<section class="section method">
  <div class="wrap">
    <h2 class="h2 reveal-title">{learn.title}</h2>
    <ul class="items">
      {learn.items.map(({ title, text }, i) => (
        <li class="item reveal">
          <div class="photo parallax">
            <Image src={visuals[i].photo} alt="" />
          </div>
          <span class="icon-circle icon-circle-accent">
            <Icon name={visuals[i].icon} />
          </span>
          <h3 class="h4">{title}</h3>
          <p class="body-sm">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .method {
    padding-top: 0;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--teal-line-soft);
    border-radius: var(--radius-card);
    background: var(--teal-glass);
    transition:
      border-color 0.25s var(--ease),
      transform 0.35s var(--ease);
  }

  .item:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  /* Stagger the row as it scrolls in. */
  .item:nth-child(2) {
    animation-range: entry 6% cover 36%;
  }

  .item:nth-child(3) {
    animation-range: entry 12% cover 42%;
  }

  .item:nth-child(4) {
    animation-range: entry 18% cover 48%;
  }

  .item > .photo {
    position: relative;
    height: 150px;
    margin-bottom: 4px;
    border-radius: var(--radius);
  }

  .photo img {
    transition: transform 1s var(--ease);
  }

  .item:hover .photo img {
    transform: scale(1.045);
  }

  h3 {
    font-size: 19px;
    font-weight: 400;
    line-height: 26px;
  }

  @media (max-width: 1080px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .items {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 32px;
    }
  }
</style>
