---
import Button from '@/components/ui/Button.astro';
import FramedPanel from '@/components/ui/FramedPanel.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  /** Defaults to the home page's closing copy, sign-up and a link to the plans page. */
  title?: string;
  lead?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = t.cta.title,
  lead = t.cta.lead,
  primary = { label: t.actions.start, href: links.signup },
  secondary = { label: t.actions.seePlans, href: getPageUrl(lang, 'plans') },
} = Astro.props;
---

<section class="cta section-dark band-haze" data-theme="dark">
  <div class="wrap">
    <FramedPanel class="content">
      <h2 class="display reveal-title">{title}</h2>
      <p class="lead reveal">{lead}</p>
      <div class="btn-row reveal">
        <Button href={primary.href}>{primary.label}</Button>
        <Button href={secondary.href} variant="ghost" icon="north-east">
          {secondary.label}
        </Button>
      </div>
    </FramedPanel>
  </div>
</section>

<style>
  .cta {
    padding-block: 72px 120px;
  }

  .cta::before {
    background:
      radial-gradient(55% 70% at 100% 100%, var(--haze), transparent 70%),
      radial-gradient(40% 50% at 0% 0%, rgb(22 164 173 / 0.1), transparent 70%);
  }

  .content {
    padding: 96px 48px 104px;
  }

  .display {
    max-width: 15ch;
    font-size: 56px;
    line-height: 62px;
  }

  .lead {
    max-width: 52ch;
    margin-top: 20px;
  }

  .btn-row {
    justify-content: center;
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .cta {
      padding-block: 40px 72px;
    }

    .content {
      padding: 64px 20px 72px;
    }

    .display {
      font-size: 34px;
      line-height: 40px;
    }

    .btn-row {
      justify-self: stretch;
    }

    .btn-row > * {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
