---
import Button from '@/components/ui/Button.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  /** Defaults to the home page's closing copy, sign-up and a link to the plans page. */
  title?: string;
  lead?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = t.cta.title,
  lead = t.cta.lead,
  primary = { label: t.actions.start, href: links.signup },
  secondary = { label: t.actions.seePlans, href: getPageUrl(lang, 'plans') },
} = Astro.props;
---

<section class="cta" data-theme="dark">
  <div class="horizon" aria-hidden="true"></div>
  <div class="wrap content">
    <h2 class="display reveal-title">{title}</h2>
    <p class="lead reveal">{lead}</p>
    <div class="btn-row reveal">
      <Button href={primary.href}>{primary.label}</Button>
      <Button href={secondary.href} variant="ghost" icon="north-east">
        {secondary.label}
      </Button>
    </div>
  </div>
</section>

<style>
  /* Clipped so the horizon's glow stays inside. */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: 160px 280px;
    text-align: center;
  }

  /* A teal horizon rising under the call, the evening to the hero's gold morning. */
  .horizon {
    position: absolute;
    bottom: -1260px;
    left: 50%;
    z-index: -1;
    width: 2200px;
    height: 1400px;
    margin-left: -1100px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--page) 97%, transparent 100%);
    box-shadow:
      0 -2px 0 0 var(--horizon-teal),
      0 -20px 80px 10px var(--horizon-teal-glow);
  }

  .content {
    display: grid;
    justify-items: center;
  }

  .display {
    max-width: 12ch;
    font-size: clamp(44px, 8vw, 112px);
    line-height: 0.94;
  }

  .lead {
    max-width: 44ch;
    margin-top: 26px;
    font-size: 20px;
    line-height: 31px;
  }

  .btn-row {
    justify-content: center;
    margin-top: 36px;
  }

  @media (max-width: 640px) {
    .cta {
      padding-block: 96px 200px;
    }

    .horizon {
      bottom: -1300px;
    }

    .lead {
      font-size: 17px;
      line-height: 27px;
    }

    .btn-row {
      justify-self: stretch;
    }

    .btn-row > * {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
