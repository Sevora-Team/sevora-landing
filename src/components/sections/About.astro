---
import { Image } from 'astro:assets';
import academyPhoto from '@/assets/photos/home/academy.webp';
import analysisPhoto from '@/assets/photos/home/analysis.webp';
import mentorPhoto from '@/assets/photos/home/mentor.webp';
import Button from '@/components/ui/Button.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { about } = useTranslations(getLangFromUrl(Astro.url));
---

<section class="section" id="o-nama">
  <div class="wrap">
    <div class="intro-center">
      <h2 class="h2 reveal-title" style="max-width: 20ch">
        {about.title}
      </h2>
      <p class="lead reveal">{about.lead}</p>
    </div>

    <div class="grid">
      <article class="card reveal" data-theme="dark">
        <div class="photo parallax">
          <Image
            src={analysisPhoto}
            alt=""
            widths={[480, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw"
          />
        </div>
        <div>
          <h3 class="h3" style="max-width: 13ch">
            {about.analysis.title}
          </h3>
          <p class="body-sm">{about.analysis.text}</p>
        </div>
        <div class="btn-row">
          <Button href="#trzista" size="sm">
            {about.analysis.cta}
          </Button>
        </div>
      </article>

      <article class="card reveal" data-theme="dark">
        <div class="photo parallax">
          <Image
            src={mentorPhoto}
            alt=""
            widths={[480, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw"
          />
        </div>
        <div>
          <h3 class="h3" style="max-width: 14ch">
            {about.mentor.title}
          </h3>
          <p class="body-sm">{about.mentor.text}</p>
        </div>
        <div class="btn-row">
          <Button href="#platforma" variant="ghost" size="sm" icon="north-east">
            {about.mentor.cta}
          </Button>
        </div>
      </article>

      <article class="card faint reveal" data-theme="dark">
        <div class="photo parallax">
          <Image
            src={academyPhoto}
            alt=""
            widths={[480, 800]}
            sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 33vw"
          />
        </div>
        <p class="label">{about.academy.label}</p>
        <div>
          <p class="stat">{about.academy.value}</p>
          <p class="body-sm">{about.academy.text}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 380px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid var(--teal-line);
    border-radius: var(--radius-card);
    background: var(--bg);
    transition:
      border-color 0.25s var(--ease),
      transform 0.35s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card > * {
    position: relative;
    z-index: 1;
  }

  /* Stagger the row as it scrolls in. */
  .card:nth-child(2) {
    animation-range: entry 6% cover 36%;
  }

  .card:nth-child(3) {
    animation-range: entry 12% cover 42%;
  }

  .card > .photo {
    position: absolute;
    z-index: 0;
  }

  .photo img {
    transition: transform 1s var(--ease);
  }

  .card:hover .photo img {
    transform: scale(1.045);
  }

  /* Keeps the text legible at the top and bottom of the card. */
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(3 6 12 / 0.78) 0%,
      rgb(3 6 12 / 0.18) 42%,
      rgb(3 6 12 / 0.82) 100%
    );
  }

  .faint .photo img {
    opacity: 0.4;
  }

  .card .body-sm {
    max-width: 30ch;
    margin-top: 10px;
  }

  .label {
    margin: 0;
    font: 400 14px/20px var(--font-sans);
    color: var(--text-muted);
  }

  .stat {
    margin: 6px 0 0;
    font: 400 56px/60px var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      min-height: 340px;
    }
  }
</style>
