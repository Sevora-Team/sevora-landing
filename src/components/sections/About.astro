---
import Button from '@/components/ui/Button.astro';
import Glyphs from '@/components/ui/Glyphs.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { about } = useTranslations(getLangFromUrl(Astro.url));
---

<section class="section" id="o-nama">
  <div class="wrap">
    <div class="intro-center reveal">
      <h2 class="h2" style="max-width: 20ch">
        {about.title}
      </h2>
      <p class="lead">{about.lead}</p>
    </div>

    <div class="grid">
      <article class="card card-grey reveal">
        <div class="lines" aria-hidden="true"></div>
        <div>
          <h3 class="h3" style="max-width: 13ch">
            {about.analysis.title}
          </h3>
          <p class="body-sm">{about.analysis.text}</p>
        </div>
        <div class="btn-row">
          <Button href="#trzista" size="sm">
            {about.analysis.cta}
          </Button>
        </div>
      </article>

      <article class="card reveal" data-theme="dark">
        <Glyphs name="wave" class="texture" />
        <div>
          <h3 class="h3" style="max-width: 14ch">
            {about.mentor.title}
          </h3>
          <p class="body-sm">{about.mentor.text}</p>
        </div>
        <div class="btn-row">
          <Button href="#platforma" variant="ghost" size="sm" icon="north-east">
            {about.mentor.cta}
          </Button>
        </div>
      </article>

      <article class="card reveal" data-theme="dark">
        <p class="label">{about.academy.label}</p>
        <div>
          <p class="stat">{about.academy.value}</p>
          <p class="body-sm">{about.academy.text}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 340px;
    padding: 28px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease),
      transform 0.35s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .card > * {
    position: relative;
    z-index: 1;
  }

  .card-grey {
    border-color: transparent;
    background: var(--surface-hover);
  }

  .card .body-sm {
    max-width: 30ch;
    margin-top: 10px;
  }

  .card > .lines,
  .card > .texture {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .lines {
    inset: 0 0 0 38%;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 1px, transparent 1px 6px);
    opacity: 0.28;
    mask-image: linear-gradient(90deg, transparent, #000 55%);
  }

  .texture {
    inset: auto 0 0;
    height: 58%;
  }

  .label {
    margin: 0;
    font: 400 14px/20px var(--font-sans);
    color: var(--text-muted);
  }

  .stat {
    margin: 6px 0 0;
    font: 400 56px/60px var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      min-height: 300px;
    }
  }
</style>
