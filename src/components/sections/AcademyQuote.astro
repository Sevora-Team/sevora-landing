---
// The Academy page's closing band: a quote in a framed panel, and the way in.
import Button from '@/components/ui/Button.astro';
import FramedPanel from '@/components/ui/FramedPanel.astro';
import { links } from '@/data/links';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const page = t.academyPage;
---

<section class="quote-band section-dark band-haze" data-theme="dark">
  <div class="wrap">
    <FramedPanel class="content">
      <blockquote class="reveal">
        <p class="quote">
          {page.quote.map(({ text, tone }) => (
            <span class:list={[tone && `tone-${tone}`]}>{text}</span>
          ))}
        </p>
        <footer class="mono-label by">{page.quoteBy}</footer>
      </blockquote>
      <div class="btn-row reveal">
        <Button href={links.signup}>{page.learnFree}</Button>
        <Button href={getPageUrl(lang, 'plans')} variant="ghost" icon="north-east">
          {t.actions.seePlans}
        </Button>
      </div>
    </FramedPanel>
  </div>
</section>

<style>
  .quote-band {
    padding-block: 72px 120px;
  }

  .quote-band::before {
    background: radial-gradient(50% 80% at 0% 100%, var(--haze), transparent 70%);
  }

  .content {
    padding: 96px 64px;
  }

  blockquote {
    display: grid;
    justify-items: center;
    margin: 0;
  }

  .quote {
    max-width: 20ch;
    margin: 0;
    font: 400 49px/58px var(--font-sans);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .tone-accent {
    color: var(--accent-text);
  }

  .tone-muted {
    color: var(--text-muted);
  }

  .by {
    margin-top: 28px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .btn-row {
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .quote-band {
      padding-block: 40px 72px;
    }

    .content {
      padding: 56px 22px;
    }

    .quote {
      font-size: 31px;
      line-height: 40px;
    }
  }
</style>
