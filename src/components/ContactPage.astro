---
// The contact page, shared by every locale like HomePage. It ends on the support details: the
// channels open the page and the form follows, so no closing call repeats them.
import PageHero from '@/components/ui/PageHero.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import ContactChannels from './ContactChannels.astro';
import Contact from './sections/Contact.astro';
import ContactInfo from './sections/ContactInfo.astro';

const page = useTranslations(getLangFromUrl(Astro.url)).contactPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead}>
    <ContactChannels slot="aside" />
  </PageHero>
  <Contact />
  <ContactInfo />
</PageLayout>
