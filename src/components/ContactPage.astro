---
// The contact page, shared by every locale like HomePage: the inquiry form.
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import Contact from './sections/Contact.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const page = t.contactPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead}>
    <div class="btn-row">
      <Button href={getPageUrl(lang, 'home', 'pitanja')} variant="ghost" icon="arrow-forward">
        {t.faq.title}
      </Button>
    </div>
  </PageHero>
  <Contact />
</PageLayout>
