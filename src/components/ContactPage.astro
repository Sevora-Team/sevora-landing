---
// The contact page, shared by every locale like HomePage.
import PageHero from '@/components/ui/PageHero.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import Contact from './sections/Contact.astro';
import ContactChannels from './sections/ContactChannels.astro';

const page = useTranslations(getLangFromUrl(Astro.url)).contactPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead} overlap />
  <ContactChannels />
  <Contact />
</PageLayout>
