---
// The landing page, shared by every locale. Components read the language from the URL,
// so locale pages only need to render this. Sections with a page of their own (plans,
// academy) appear here as teasers; the contact form lives only on its page.
import Footer from './Footer.astro';
import Header from './Header.astro';
import About from './sections/About.astro';
import Academy from './sections/Academy.astro';
import ClosingCta from './sections/ClosingCta.astro';
import Ecosystem from './sections/Ecosystem.astro';
import Faq from './sections/Faq.astro';
import Hero from './sections/Hero.astro';
import Markets from './sections/Markets.astro';
import PlanTeaser from './sections/PlanTeaser.astro';
import Platform from './sections/Platform.astro';
import PricingTeaser from './sections/PricingTeaser.astro';
import Steps from './sections/Steps.astro';
---

<Header />
<main>
  <Hero />
  <About />
  <Markets />
  <Platform />
  <PlanTeaser />
  <Steps />
  <Academy />
  <Ecosystem />
  <PricingTeaser />
  <Faq />
  <ClosingCta />
</main>
<Footer />
