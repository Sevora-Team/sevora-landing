---
interface Props {
  tone?: 'neutral' | 'up' | 'down' | 'session';
}

const { tone = 'neutral' } = Astro.props;
const arrow = tone === 'up' ? '▲' : tone === 'down' ? '▼' : undefined;
---

<span class:list={['badge', tone]}>
  {arrow && <span aria-hidden="true">{arrow}</span>}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 3px 9px;
    border-radius: var(--radius-xs);
    background: var(--surface-hover);
    color: var(--text-body);
    font: 500 12px/16px var(--font-mono);
    white-space: nowrap;
  }

  .up {
    color: var(--up);
  }

  .down {
    color: var(--down);
  }

  .session {
    background: var(--accent-subtle);
    color: var(--accent-text);
  }
</style>
