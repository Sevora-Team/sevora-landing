---
interface Row {
  label: string;
  /** Omit to show the row as locked. */
  value?: string;
}

interface Props {
  rows: Row[];
  footer: string;
  cta: string;
  ctaHref: string;
  lockedLabel: string;
}

const { rows, footer, cta, ctaHref, lockedLabel } = Astro.props;
---

<div class="lock">
  <dl>
    {rows.map(({ label, value }) => (
      <div class="row">
        <dt>{label}</dt>
        <dd>{value ?? <span class="mask" role="img" aria-label={lockedLabel} />}</dd>
      </div>
    ))}
  </dl>
  <p class="foot">
    <span>{footer}</span>
    <a href={ctaHref}>{cta}</a>
  </p>
</div>

<style>
  .lock {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    font: 400 14px/20px var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--text-body);
  }

  dd {
    margin: 0;
    font-weight: 500;
    color: var(--text);
  }

  .mask {
    display: inline-block;
    width: 64px;
    height: 12px;
    margin-top: 4px;
    border-radius: 3px;
    background: var(--border);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin: 2px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font: 400 12px/16px var(--font-sans);
    color: var(--text-muted);
  }

  .foot a {
    font-weight: 500;
    color: var(--accent-text);
  }
</style>
