---
// Dark, centred opening band of a page below home: breadcrumbs, the page's h1 and lead over
// the home hero's dot grid, with a quieter gold horizon low in the band. The default slot follows the lead (a toggle). The `below` slot is full width under
// the text, and the hero then fills the viewport (the Academy's level path).
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  /** Short page name, the last breadcrumb. */
  name: string;
  title: string;
  lead: string;
  /** Leaves room at the bottom for the cards right after the hero to rise into it. */
  overlap?: boolean;
}

const { name, title, lead, overlap = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { breadcrumb } = useTranslations(lang);
const below = Astro.slots.has('below');
// Text with controls in it stays put; otherwise it lifts away as the page scrolls.
const controls = Astro.slots.has('default');
---

<section class:list={['page-hero section-dark', { overlap, 'has-below': below }]} data-theme="dark">
  <div class="horizon" aria-hidden="true"></div>
  <div class:list={['wrap content', { leaves: !controls }]}>
    <nav class="crumbs rise" aria-label={breadcrumb.label}>
      <ol>
        <li>
          <a href={getPageUrl(lang, 'home')}>{breadcrumb.home}</a>
        </li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>
    <h1 class="display rise" style="--delay: 0.08s">
      {title}
    </h1>
    <p class="lead rise" style="--delay: 0.16s">
      {lead}
    </p>
    {controls && (
      <div class="extra rise" style="--delay: 0.24s">
        <slot />
      </div>
    )}
  </div>
  {below && (
    <div class="wrap below">
      <slot name="below" />
    </div>
  )}
</section>

<style>
  @keyframes rise-horizon {
    from {
      opacity: 0;
      translate: 0 80px;
    }
  }

  @keyframes content-out {
    to {
      opacity: 0;
      translate: 0 -64px;
    }
  }

  .page-hero {
    /* Slide under the sticky header. */
    --peak: 150px;
    isolation: isolate;
    margin-top: -84px;
    padding-top: 84px;
  }

  .overlap {
    --peak: 216px;
  }

  .has-below {
    --peak: 120px;
  }

  /* The home hero's faint dot grid around the heading. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: radial-gradient(rgb(124 137 150 / 0.16) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 50% at 50% 25%, #000 30%, transparent 75%);
  }

  /* The home hero's gold horizon, thinner and lower: its top sits --peak above the band's end.
     Only the line and its glow are drawn, so the page backdrop runs on into the next section. */
  .horizon {
    position: absolute;
    top: calc(100% - var(--peak));
    left: 50%;
    z-index: -1;
    width: 2400px;
    height: 1400px;
    margin-left: -1200px;
    border-radius: 50%;
    box-shadow:
      0 -1px 0 0 var(--horizon-gold),
      0 -8px 40px 0 var(--horizon-gold-glow);
    animation: rise-horizon 1.8s var(--ease-out) both;
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-block: 80px calc(var(--peak) + 72px);
    text-align: center;
  }

  @supports (animation-timeline: scroll()) {
    .leaves {
      animation-name: content-out;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 70vh;
    }
  }

  .overlap .content {
    padding-bottom: 240px;
  }

  .has-below .content {
    padding-bottom: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin: 0 8px;
  }

  .crumbs a {
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .crumbs [aria-current] {
    color: var(--accent-text);
  }

  .display {
    max-width: 17ch;
  }

  .lead {
    text-align: center;
  }

  .extra {
    display: grid;
    justify-items: center;
    margin-top: 12px;
  }

  .below {
    position: relative;
    z-index: 2;
  }

  /* With content below, the hero fills the viewport and the text tightens with its height. */
  @media (min-width: 641px) {
    .has-below {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100svh;
      min-height: 720px;
      max-height: 1200px;
    }

    .has-below .content {
      flex: none;
      gap: clamp(12px, 2vh, 20px);
      padding-top: clamp(24px, 6vh, 80px);
    }

    .has-below .display {
      font-size: clamp(44px, 6.4vh, 64px);
      line-height: 1.08;
    }

    .has-below .below {
      display: flex;
      flex: 1 1 auto;
      align-items: flex-end;
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      --peak: 72px;
      margin-top: -68px;
      padding-top: 68px;
    }

    .overlap {
      --peak: 168px;
    }

    /* The level path scrolls sideways here, so the line sits just above its cards. */
    .has-below {
      --peak: 160px;
    }

    .content {
      padding-block: 48px calc(var(--peak) + 48px);
    }

    .overlap .content {
      padding-bottom: 200px;
    }

    .has-below .content {
      padding-bottom: 0;
    }
  }
</style>
