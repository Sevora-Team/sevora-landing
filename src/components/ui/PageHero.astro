---
// Dark opening band of a page below home: breadcrumbs, the page's h1 and lead.
// The default slot holds what follows the lead (actions, stats).
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Glyphs from './Glyphs.astro';

interface Props {
  /** Short page name, the last breadcrumb. */
  name: string;
  title: string;
  lead: string;
}

const { name, title, lead } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { breadcrumb } = useTranslations(lang);
---

<section class="page-hero section-dark" data-theme="dark">
  <div class="wrap content">
    <nav class="crumbs rise" aria-label={breadcrumb.label}>
      <ol>
        <li>
          <a href={getPageUrl(lang, 'home')}>{breadcrumb.home}</a>
        </li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>
    <h1 class="display rise" style="--delay: 0.08s">
      {title}
    </h1>
    <p class="lead rise" style="--delay: 0.16s">
      {lead}
    </p>
    <div class="extra rise" style="--delay: 0.24s">
      <slot />
    </div>
  </div>
  <Glyphs name="dome" class="dome" />
</section>

<style>
  .page-hero {
    /* Slide under the sticky header. */
    margin-top: -84px;
    padding: 84px 0 300px;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(55% 65% at 0% 100%, rgb(66 202 215 / 0.11), transparent 70%),
      radial-gradient(35% 45% at 100% 0%, rgb(66 202 215 / 0.05), transparent 70%);
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    padding-top: 64px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin: 0 10px;
  }

  .crumbs a {
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .crumbs [aria-current] {
    color: var(--accent-text);
  }

  .display {
    max-width: 18ch;
    margin-top: 24px;
  }

  .lead {
    max-width: 60ch;
    margin-top: 20px;
  }

  .extra {
    margin-top: 32px;
  }

  .dome {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 260px;
    pointer-events: none;
    animation: rise 1.4s var(--ease) 0.35s both;
  }

  @media (max-width: 640px) {
    .page-hero {
      margin-top: -68px;
      padding: 68px 0 180px;
    }

    .content {
      padding-top: 40px;
    }

    .dome {
      height: 180px;
    }
  }
</style>
