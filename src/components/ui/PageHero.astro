---
// Dark, centred opening band of a page below home: breadcrumbs, the page's h1 and lead.
// The default slot follows the lead (actions, a toggle). The `below` slot is full width under
// the text and takes the place of the glyph dome (the Academy's level path).
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Glyphs from './Glyphs.astro';

interface Props {
  /** Short page name, the last breadcrumb. */
  name: string;
  title: string;
  lead: string;
  /** Leaves room at the bottom for the cards right after the hero to rise into it. */
  overlap?: boolean;
}

const { name, title, lead, overlap = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { breadcrumb } = useTranslations(lang);
const below = Astro.slots.has('below');
---

<section class:list={['page-hero section-dark', { overlap, 'has-below': below }]} data-theme="dark">
  <div class="wrap content">
    <nav class="crumbs rise" aria-label={breadcrumb.label}>
      <ol>
        <li>
          <a href={getPageUrl(lang, 'home')}>{breadcrumb.home}</a>
        </li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>
    <h1 class="display rise" style="--delay: 0.08s">
      {title}
    </h1>
    <p class="lead rise" style="--delay: 0.16s">
      {lead}
    </p>
    {Astro.slots.has('default') && (
      <div class="extra rise" style="--delay: 0.24s">
        <slot />
      </div>
    )}
  </div>
  {below ? (
    <div class="wrap below">
      <slot name="below" />
    </div>
  ) : (
    <Glyphs name="dome" class="dome" />
  )}
</section>

<style>
  .page-hero {
    /* Slide under the sticky header. */
    margin-top: -84px;
    padding-top: 84px;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(55% 70% at 0% 100%, rgb(66 202 215 / 0.1), transparent 70%),
      radial-gradient(35% 45% at 100% 0%, rgb(66 202 215 / 0.05), transparent 70%);
  }

  .content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 20px;
    padding-block: 80px 104px;
    text-align: center;
  }

  .overlap .content {
    padding-bottom: 230px;
  }

  .has-below .content {
    padding-bottom: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 12px/16px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin: 0 8px;
  }

  .crumbs a {
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .crumbs [aria-current] {
    color: var(--accent-text);
  }

  .display {
    max-width: 17ch;
  }

  .lead {
    text-align: center;
  }

  .extra {
    display: grid;
    justify-items: center;
    margin-top: 12px;
  }

  .below {
    position: relative;
    z-index: 2;
  }

  .dome {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 240px;
    opacity: 0.55;
    pointer-events: none;
    animation: rise 1.4s var(--ease) 0.3s both;
  }

  @media (max-width: 640px) {
    .page-hero {
      margin-top: -68px;
      padding-top: 68px;
    }

    .content {
      padding-block: 48px 72px;
    }

    .overlap .content {
      padding-bottom: 180px;
    }

    .has-below .content {
      padding-bottom: 0;
    }
  }
</style>
