---
// Opening band of a page below home: breadcrumbs, the page's h1 and lead, left-aligned over the
// home hero's dot grid, closed by the day line laid flat. The default slot follows the lead (a
// toggle, actions). `aside` sits beside the text: the page's own artifact. `below` runs full
// width under it (the Academy's level path).
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  /** Short page name, the last breadcrumb. */
  name: string;
  title: string;
  lead: string;
}

const { name, title, lead } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { breadcrumb } = useTranslations(lang);
const extra = Astro.slots.has('default');
const aside = Astro.slots.has('aside');
const below = Astro.slots.has('below');
---

<section class:list={['page-hero', { 'has-aside': aside, 'has-below': below }]} data-theme="dark">
  <div class="wrap top">
    <div class="text">
      <nav class="crumbs rise" aria-label={breadcrumb.label}>
        <ol>
          <li>
            <a href={getPageUrl(lang, 'home')}>{breadcrumb.home}</a>
          </li>
          <li aria-current="page">{name}</li>
        </ol>
      </nav>
      <h1 class="display rise" style="--delay: 0.06s">
        {title}
      </h1>
      <p class="lead rise" style="--delay: 0.12s">
        {lead}
      </p>
      {extra && (
        <div class="extra rise" style="--delay: 0.18s">
          <slot />
        </div>
      )}
    </div>
    {aside && (
      <div class="aside rise" style="--delay: 0.24s">
        <slot name="aside" />
      </div>
    )}
  </div>
  {below && (
    <div class="wrap below">
      <slot name="below" />
    </div>
  )}
  <div class="baseline" aria-hidden="true"></div>
</section>

<style>
  @keyframes draw-line {
    from {
      scale: 0 1;
    }
  }

  .page-hero {
    position: relative;
    isolation: isolate;
    /* Slide under the sticky header. */
    margin-top: -84px;
    padding-top: 84px;
  }

  /* The home hero's faint dot grid, gathered behind the headline. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(124 137 150 / 0.16) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 60% 70% at 15% 40%, #000 20%, transparent 75%);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 48px 72px;
    padding-block: 88px 72px;
  }

  .has-aside .top {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .has-below .top {
    padding-bottom: 40px;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 14px/20px var(--font-sans);
    color: var(--text-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin: 0 10px;
    color: var(--text-disabled);
  }

  .crumbs a {
    text-underline-offset: 4px;
    text-decoration-color: transparent;
    transition:
      color 0.2s var(--ease),
      text-decoration-color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  .crumbs [aria-current] {
    color: var(--text-body);
  }

  .display {
    max-width: 15ch;
    font-size: clamp(44px, 5.4vw, 80px);
    line-height: 1;
    text-wrap: balance;
  }

  .lead {
    max-width: 50ch;
    font-size: 19px;
    line-height: 30px;
  }

  .extra {
    margin-top: 10px;
  }

  /* The day line, gold morning to teal evening, drawn once from the left. */
  .baseline {
    height: 1px;
    margin-inline: var(--gutter);
    background: var(--day-line-x);
    box-shadow: 0 -6px 24px 0 var(--horizon-gold-glow);
    transform-origin: left;
    animation: draw-line 1.6s var(--ease-out) 0.2s both;
  }

  @media (max-width: 1080px) {
    .has-aside .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      margin-top: -68px;
      padding-top: 68px;
    }

    .top {
      gap: 40px;
      padding-block: 48px;
    }

    .text {
      gap: 18px;
    }

    .display {
      font-size: 42px;
      line-height: 1.04;
    }

    .lead {
      font-size: 17px;
      line-height: 27px;
    }

    .baseline {
      margin-inline: 16px;
    }
  }
</style>
