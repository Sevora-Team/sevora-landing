---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { langTags, languages, type Lang } from '@/i18n/locales';
import { getLangFromUrl, getPathWithoutLocale, useTranslations } from '@/i18n/utils';

const current = getLangFromUrl(Astro.url);
const t = useTranslations(current);
const path = getPathWithoutLocale(Astro.url);
---

<div class="switch" role="group" aria-label={t.language}>
  {(Object.keys(languages) as Lang[]).map((lang) => (
    <a
      href={getRelativeLocaleUrl(lang, path)}
      hreflang={langTags[lang]}
      lang={langTags[lang]}
      aria-current={lang === current ? 'true' : undefined}
    >
      {lang.toUpperCase()}
      <span class="sr-only"> — {languages[lang]}</span>
    </a>
  ))}
</div>

<style>
  .switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  a {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font: 500 12px/16px var(--font-mono);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  a:hover {
    color: var(--text);
  }

  [aria-current] {
    background: var(--surface-hover);
    color: var(--text);
  }
</style>
