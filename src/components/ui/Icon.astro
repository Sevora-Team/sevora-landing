---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Rendered width and height in px. */
  size?: number;
  /** Accessible name. Omit for decorative icons, which are hidden from assistive tech. */
  label?: string;
  class?: string;
}

// `rest` carries the parent's scoped-style attribute, so parents can style the icon.
const { name, size = 20, label, class: className, ...rest } = Astro.props;
const Svg = icons[name];
---

<Svg
  width={size}
  height={size}
  fill="currentColor"
  class={className}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
/>
