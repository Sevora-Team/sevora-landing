---
import Icon from './Icon.astro';

interface Props {
  items: { question: string; answer: string }[];
  /** Shared `<details name>`, so opening one answer closes the others. */
  name: string;
  /** `lg` for a full-width list. */
  size?: 'md' | 'lg';
}

const { items, name, size = 'md' } = Astro.props;
---

<div class:list={['faq-list', `faq-${size}`]}>
  {items.map(({ question, answer }) => (
    <details name={name} class="reveal-left">
      <summary>
        {question}
        <span class="toggle">
          <Icon name="expand-more" />
        </span>
      </summary>
      <p>{answer}</p>
    </details>
  ))}
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
    animation-range: entry 0% cover 22%;
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    color: var(--text);
    font: 400 19px/28px var(--font-sans);
    list-style: none;
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }

  .faq-lg summary {
    padding: 26px 0;
    font-size: 20px;
    line-height: 30px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent-text);
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    background: var(--surface-hover);
    color: var(--text);
    transition: transform 0.3s var(--ease);
  }

  details[open] .toggle {
    transform: rotate(180deg);
  }

  details p {
    max-width: 64ch;
    margin: 0;
    padding: 0 56px 24px 0;
    animation: fade 0.35s var(--ease) both;
  }

  .faq-lg details p {
    max-width: none;
    padding-right: 72px;
  }

  @media (max-width: 640px) {
    details p,
    .faq-lg details p {
      padding-right: 0;
    }
  }
</style>
