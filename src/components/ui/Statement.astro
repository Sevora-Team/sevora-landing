---
interface Props {
  /** The sentence in parts; `accent` and `muted` parts stand out from the rest. */
  parts: { text: string; tone?: 'accent' | 'muted' }[];
  class?: string;
}

// `rest` carries the parent's scoped-style attribute, so parents can place the statement.
const { parts, class: className, ...rest } = Astro.props;
---

<p class:list={['statement', className]} {...rest}>
  {parts.map(({ text, tone }) => (
    <span class:list={[tone && `tone-${tone}`]}>{text}</span>
  ))}
</p>

<style>
  @keyframes ink {
    from {
      opacity: 0.18;
    }
  }

  .statement {
    max-width: 30ch;
    margin: 0;
    font: 400 34px/46px var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  /* Words darken as the statement scrolls into view. */
  @supports (animation-timeline: view()) {
    .statement span {
      animation-name: ink;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }
  }

  .tone-accent {
    color: var(--accent-text);
  }

  .tone-muted {
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .statement {
      font-size: 24px;
      line-height: 34px;
    }
  }
</style>
