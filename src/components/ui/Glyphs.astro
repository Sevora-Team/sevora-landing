---
import { textures, type TextureName } from '@/lib/glyphs';

interface Props {
  name: TextureName;
  /** SVG `preserveAspectRatio`; the textures always fill (`slice`) their box. */
  align?: string;
  class?: string;
}

const { name, align = 'xMidYMax', class: className, ...rest } = Astro.props;
const { width, height, layers } = textures[name];
---

<svg
  class:list={['glyphs', className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio={`${align} slice`}
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <path class="c" d={layers.c}></path>
  <path class="b" d={layers.b}></path>
  <path class="a" d={layers.a}></path>
  {layers.x && <path class="x" d={layers.x} />}
</svg>

<style>
  @keyframes breathe {
    50% {
      fill-opacity: 0.7;
    }
  }

  /* Low specificity so the parent's sizing class always wins. */
  :where(.glyphs) {
    width: 100%;
    height: 100%;
  }

  path {
    fill: var(--glyph);
  }

  .a {
    fill-opacity: 0.9;
  }

  .b {
    fill-opacity: 0.5;
    animation: breathe 9s ease-in-out 2s infinite;
  }

  .c {
    fill-opacity: 0.2;
  }

  .x {
    fill: var(--accent);
    fill-opacity: 0.85;
  }
</style>
