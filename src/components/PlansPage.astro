---
// The plans and pricing page, shared by every locale like HomePage.
import photo from '@/assets/photos/heroes/plans.webp';
import BillingToggle from '@/components/ui/BillingToggle.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { prices } from '@/data/pricing';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import ClosingCta from './sections/ClosingCta.astro';
import PlanComparison from './sections/PlanComparison.astro';
import PlansFaq from './sections/PlansFaq.astro';
import Pricing from './sections/Pricing.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const page = t.plansPage;
const { plans } = t.pricing;
// The plans as offers at their monthly price, read from the same data as the cards.
const product = Astro.site && {
  '@type': 'Product',
  name: 'SEVORA',
  description: page.meta.description,
  brand: { '@type': 'Brand', name: 'SEVORA' },
  offers: [
    { name: plans.free.name, price: 0 },
    { name: plans.starter.name, price: prices[lang].starter },
    { name: plans.premium.name, price: prices[lang].premium },
  ].map(({ name, price }) => ({
    '@type': 'Offer',
    name,
    price,
    priceCurrency: prices[lang].currency,
    url: new URL(getPageUrl(lang, 'plans'), Astro.site).href,
  })),
};
---

<PageLayout
  name={page.name}
  title={page.meta.title}
  description={page.meta.description}
  structuredData={product ? [product] : []}
>
  <PageHero name={page.name} title={page.title} lead={page.lead} photo={photo} overlap>
    <BillingToggle />
  </PageHero>
  <Pricing />
  <PlanComparison />
  <PlansFaq />
  <ClosingCta
    title={page.cta.title}
    lead={page.cta.lead}
    secondary={{ label: page.cta.contact, href: getPageUrl(lang, 'contact') }}
  />
</PageLayout>
