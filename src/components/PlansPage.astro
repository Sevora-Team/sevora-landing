---
// The plans and pricing page, shared by every locale like HomePage.
import BillingToggle from '@/components/ui/BillingToggle.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import ClosingCta from './sections/ClosingCta.astro';
import PlanComparison from './sections/PlanComparison.astro';
import PlansFaq from './sections/PlansFaq.astro';
import Pricing from './sections/Pricing.astro';

const lang = getLangFromUrl(Astro.url);
const page = useTranslations(lang).plansPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead} overlap>
    <BillingToggle />
  </PageHero>
  <Pricing />
  <PlanComparison />
  <PlansFaq />
  <ClosingCta
    title={page.cta.title}
    lead={page.cta.lead}
    secondary={{ label: page.cta.contact, href: getPageUrl(lang, 'contact') }}
  />
</PageLayout>
