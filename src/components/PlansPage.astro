---
// The plans and pricing page, shared by every locale like HomePage.
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import ClosingCta from './sections/ClosingCta.astro';
import Faq from './sections/Faq.astro';
import PlanComparison from './sections/PlanComparison.astro';
import Pricing from './sections/Pricing.astro';

const t = useTranslations(getLangFromUrl(Astro.url));
const page = t.plansPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead}>
    <div class="btn-row">
      <Button href={links.signup}>{t.actions.start}</Button>
      <Button href="#poredjenje" variant="ghost" icon="arrow-forward">
        {page.comparison.title}
      </Button>
    </div>
  </PageHero>
  <Pricing onPlansPage />
  <PlanComparison />
  <Faq />
  <ClosingCta />
</PageLayout>
