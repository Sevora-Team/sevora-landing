---
// The support page, shared by every locale like HomePage: FAQ first, then the inquiry form.
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import Contact from './sections/Contact.astro';
import Faq from './sections/Faq.astro';

const t = useTranslations(getLangFromUrl(Astro.url));
const page = t.supportPage;
---

<PageLayout name={page.name} title={page.meta.title} description={page.meta.description}>
  <PageHero name={page.name} title={page.title} lead={page.lead}>
    <div class="btn-row">
      <Button href="#kontakt" icon="arrow-forward">
        {page.write}
      </Button>
    </div>
  </PageHero>
  <Faq />
  <Contact />
</PageLayout>
