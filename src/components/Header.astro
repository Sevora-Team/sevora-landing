---
import { links } from '@/data/links';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import LanguageSwitch from './ui/LanguageSwitch.astro';
import Logo from './ui/Logo.astro';

const t = useTranslations(getLangFromUrl(Astro.url));
const [first] = t.nav.items;
---

<header class="header" data-theme="dark">
  <div class="wrap">
    <div class="bar">
      <Logo />
      <nav class="nav" aria-label={t.nav.label}>
        {t.nav.items.map(({ label, href }) => (
          <a href={href} aria-current={href === first.href ? 'true' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <div class="actions">
        <LanguageSwitch />
        <a class="login" href={links.login}>
          {t.actions.login}
          <Icon name="north-east" size={16} />
        </a>
        <Button class="start" href={links.signup} icon="north-east">
          {t.actions.start}
        </Button>
        <button
          class="menu-toggle"
          type="button"
          aria-label={t.nav.menu}
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <Icon name="menu" class="icon-open" />
          <Icon name="close" class="icon-close" />
        </button>
      </div>
    </div>

    <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.label} hidden>
      {t.nav.items.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
      <div class="mobile-actions">
        <Button href={links.signup} icon="north-east">
          {t.actions.start}
        </Button>
        <a class="login" href={links.login}>
          {t.actions.login}
          <Icon name="north-east" size={16} />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileNav = header?.querySelector<HTMLElement>('.mobile-nav');

  // Mobile menu
  function setMenu(open: boolean) {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute('aria-expanded', String(open));
    mobileNav.hidden = !open;
  }
  toggle?.addEventListener('click', () => setMenu(Boolean(mobileNav?.hidden)));
  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  // Scroll spy: highlight the section under the upper half of the viewport.
  const navLinks = [...(header?.querySelectorAll<HTMLAnchorElement>('.nav a') ?? [])];
  const sections = navLinks.map((link) => document.querySelector(link.hash));
  let frame = 0;

  function syncActive() {
    frame = 0;
    const headerHeight = header?.offsetHeight ?? 0;
    const line = headerHeight + (window.innerHeight - headerHeight) * 0.45;
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    let active = 0;
    if (atBottom) active = sections.length - 1;
    else if (window.scrollY > 120) {
      sections.forEach((section, i) => {
        if (section && section.getBoundingClientRect().top <= line) active = i;
      });
    }
    navLinks.forEach((link, i) => {
      if (i === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      frame ||= requestAnimationFrame(syncActive);
    },
    { passive: true },
  );
  syncActive();
</script>

<style>
  @keyframes header-solid {
    from {
      background-color: rgb(3 6 12 / 0);
      border-bottom-color: transparent;
    }
    to {
      background-color: rgb(3 6 12 / 0.86);
      border-bottom-color: var(--border);
    }
  }

  @keyframes header-tight {
    to {
      height: 68px;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: var(--bg);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    height: 84px;
  }

  /* Transparent over the hero, solid and shorter once the page scrolls. */
  @supports (animation-timeline: scroll()) {
    .header {
      animation: header-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 160px;
    }

    .bar {
      animation: header-tight linear both;
      animation-timeline: scroll(root);
      animation-range: 0 160px;
    }
  }

  /* The open mobile menu extends past the hero, so it needs a solid background. */
  .header:has(.mobile-nav:not([hidden])) {
    animation: none;
    border-bottom-color: var(--border);
    background: var(--bg);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav a {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    color: var(--text-body);
    font: 500 14px/20px var(--font-sans);
    text-decoration: none;
    transition:
      color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .actions {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 16px;
  }

  .login {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text);
    font: 500 14px/20px var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .login svg {
    transition: transform 0.25s var(--ease);
  }

  .login:hover svg {
    transform: translate(2px, -2px);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }

  .menu-toggle:hover {
    background: var(--surface-hover);
  }

  .menu-toggle[aria-expanded='true'] .icon-open,
  .menu-toggle[aria-expanded='false'] .icon-close {
    display: none;
  }

  .mobile-nav {
    padding: 8px 0 16px;
    animation: fade 0.25s var(--ease) both;
  }

  .mobile-nav > a {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font: 400 20px/28px var(--font-sans);
    text-decoration: none;
  }

  .mobile-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
  }

  @media (max-width: 1240px) {
    .nav a {
      padding: 6px 9px;
      font-size: 13.5px;
    }

    .actions {
      gap: 12px;
    }
  }

  @media (max-width: 1080px) {
    .bar {
      grid-template-columns: auto 1fr;
    }

    .nav,
    .actions > .login,
    .actions > .start {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 1081px) {
    .mobile-nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .bar {
      height: 68px;
    }
  }
</style>
