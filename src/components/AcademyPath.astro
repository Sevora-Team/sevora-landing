---
// The Academy hero's path: one step per level, rising to the right and standing on the hero's
// day line, each linking to its level below.
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels, levelPlan } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const levels = await getLevels();
---

<nav class="path" aria-label={t.academyPage.path}>
  {levels.map(({ id, order, label, title, lessonCount }) => (
    <a class="step" href={`#${id}`} style={`--i: ${order}`}>
      <span class="num" aria-hidden="true">
        {order}
      </span>
      <span class="name">
        <span class="sr-only">{label[lang]}: </span>
        {title[lang]}
      </span>
      <span class="meta">
        {t.academyPage.level.lessons(lessonCount)}
        {levelPlan(order) === 'free' && <span class="free">{t.academyBand.free}</span>}
      </span>
    </a>
  ))}
</nav>

<style>
  @keyframes step-up {
    from {
      clip-path: inset(100% 0 0 0);
    }
  }

  .path {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    gap: 8px;
  }

  .step {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 6px;
    height: calc(118px + var(--i) * 26px);
    padding: 16px 18px 18px;
    border: 1px solid var(--teal-line-soft);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    /* Teal deepens with the level. */
    background: linear-gradient(
      180deg,
      rgb(66 202 215 / calc(0.04 + var(--i) * 0.03)),
      rgb(12 21 32 / 0.6)
    );
    text-decoration: none;
    animation: step-up 1s var(--ease-out) both;
    animation-delay: calc(0.3s + var(--i) * 0.07s);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .step:hover {
    border-color: var(--teal-line);
    background: linear-gradient(
      180deg,
      rgb(66 202 215 / calc(0.1 + var(--i) * 0.04)),
      rgb(12 21 32 / 0.6)
    );
  }

  .num {
    color: var(--accent-text);
    font: 700 28px/1 var(--font-display);
  }

  .name {
    color: var(--text);
    font: 500 16px/22px var(--font-sans);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    color: var(--text-muted);
    font: 400 13px/18px var(--font-sans);
  }

  /* Free levels carry the morning gold. */
  .free {
    color: var(--price);
  }

  /* The whole climb fits a phone: narrow risers with just the level number. */
  @media (max-width: 640px) {
    .path {
      gap: 4px;
    }

    .step {
      grid-template-rows: auto;
      height: calc(52px + var(--i) * 16px);
      padding: 10px 0 0;
      text-align: center;
    }

    .num {
      font-size: 22px;
    }

    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .meta {
      display: none;
    }
  }
</style>
