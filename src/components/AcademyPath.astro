---
// The Academy hero's path: one step per level, rising to the right, each linking to its card.
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getLevels, levelPlan } from '@/lib/academy';

const lang = getLangFromUrl(Astro.url);
const page = useTranslations(lang).academyPage;
const levels = await getLevels();
---

<nav class="path" aria-label={page.path}>
  {levels.map(({ id, order, label, title, lessonCount }) => (
    <a
      class:list={['step', { free: levelPlan(order) === 'free' }]}
      href={`#${id}`}
      style={`--i: ${order}`}
    >
      <span>
        <span class="mono-label label">{label[lang]}</span>
        <strong>{title[lang]}</strong>
      </span>
      <span class="caption">{page.level.lessons(lessonCount)}</span>
    </a>
  ))}
</nav>

<style>
  @keyframes step-up {
    from {
      clip-path: inset(100% 0 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .path {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: end;
    gap: 10px;
    margin-top: 72px;
  }

  .step {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    height: calc(128px + var(--i) * 46px);
    padding: 18px 18px 22px;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background: var(--surface);
    text-decoration: none;
    animation: step-up 1.1s var(--ease) both;
    animation-delay: calc(0.35s + var(--i) * 0.09s);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .step:hover {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  /* Free levels carry an accent line on top. */
  .free {
    box-shadow: inset 0 2px 0 var(--accent);
  }

  .label {
    color: var(--accent-text);
    text-transform: uppercase;
  }

  strong {
    display: block;
    margin-top: 6px;
    color: var(--text);
    font: 400 18px/24px var(--font-sans);
  }

  @media (max-width: 640px) {
    .path {
      grid-template-columns: repeat(6, 132px);
      margin-top: 48px;
      margin-inline: -16px;
      padding-inline: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    /* A minimum, so a level name on two lines still fits. */
    .step {
      height: auto;
      min-height: calc(112px + var(--i) * 18px);
      padding: 14px;
    }
  }
</style>
