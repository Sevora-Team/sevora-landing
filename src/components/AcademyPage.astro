---
// The Academy page, shared by every locale like HomePage.
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { langTags } from '@/i18n/locales';
import { getPageUrl } from '@/i18n/routes';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import PageLayout from '@/layouts/PageLayout.astro';
import AcademyPath from './AcademyPath.astro';
import AcademyIntro from './sections/AcademyIntro.astro';
import AcademyLevels from './sections/AcademyLevels.astro';
import AcademyMethod from './sections/AcademyMethod.astro';
import AcademyQuote from './sections/AcademyQuote.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const page = t.academyPage;
const course = Astro.site && {
  '@type': 'Course',
  name: page.title,
  description: page.meta.description,
  inLanguage: langTags[lang],
  provider: {
    '@type': 'Organization',
    name: 'SEVORA',
    url: new URL(getPageUrl(lang, 'home'), Astro.site).href,
  },
};
---

<PageLayout
  name={page.name}
  title={page.meta.title}
  description={page.meta.description}
  structuredData={course ? [course] : []}
>
  <PageHero name={page.name} title={page.title} lead={page.lead}>
    <div class="btn-row">
      <Button href="#nivo-0">{page.start}</Button>
      <Button href={getPageUrl(lang, 'plans')} variant="ghost" icon="north-east">
        {t.actions.seePlans}
      </Button>
    </div>
    <AcademyPath slot="below" />
  </PageHero>
  <AcademyIntro />
  <AcademyLevels />
  <AcademyMethod />
  <AcademyQuote />
</PageLayout>

<style>
  .btn-row {
    justify-content: center;
  }
</style>
